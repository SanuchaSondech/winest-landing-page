---
// SkeletonScreen.astro - Global Zero-Spinner Skeleton Loading & Shimmer Engine
// Provides high-performance perceived loading state tailored per page layout for slow mobile devices and weak 3G networks.
import '../../styles/skeleton.css';

export interface Props {
  pageType?: 'home' | 'profile' | 'commissions' | 'about' | string;
}

const { pageType = 'home' } = Astro.props;
---

<!-- Instantaneous Skeleton Screen Overlay (Pre-rendered in DOM, 0ms initial delay) -->
<div id="winest-skeleton-overlay" class="winest-skeleton-overlay" aria-hidden="true">
  <div class="skeleton-container">
    <!-- 1. Header / Navbar Skeleton (Accurately mirrors Navbar.astro for desktop and mobile) -->
    <header class="sk-header">
      <div class="sk-bone sk-brand-logo"></div>
      
      <!-- Desktop Nav Links -->
      <nav class="sk-nav-links">
        <div class="sk-bone sk-nav-pill"></div>
        <div class="sk-bone sk-nav-pill"></div>
        <div class="sk-bone sk-nav-pill"></div>
        <div class="sk-bone sk-nav-pill"></div>
      </nav>

      <!-- Desktop Action Pills -->
      <div class="sk-desktop-actions">
        <div class="sk-bone sk-lang-pill"></div>
        <div class="sk-bone sk-theme-pill"></div>
      </div>

      <!-- Mobile Actions (Accurate Lang + Theme + 40x40 Hamburger Box) -->
      <div class="sk-mobile-actions">
        <div class="sk-bone sk-mobile-lang"></div>
        <div class="sk-bone sk-mobile-theme"></div>
        <div class="sk-bone sk-hamburger">
          <span class="sk-hamburger-line"></span>
          <span class="sk-hamburger-line"></span>
          <span class="sk-hamburger-line"></span>
        </div>
      </div>
    </header>

    <!-- 2. Dynamic Layout Skeleton tailored to current page -->
    {pageType === 'profile' ? (
      /* --- Profile Dossier Skeleton (/members/[slug]) --- */
      <div class="sk-profile-wrap">
        <div class="sk-bone sk-profile-banner"></div>
        <div class="sk-dossier-grid">
          <!-- Left: Tall Model Silhouette Frame -->
          <div class="sk-bone sk-model-column"></div>
          <!-- Right: Info Column -->
          <div class="sk-info-column">
            <div class="sk-bone sk-nameplate"></div>
            <div class="sk-bone sk-dossier-block">
              <div class="sk-bone sk-title-line"></div>
              <div class="sk-bone sk-card-body-line"></div>
              <div class="sk-bone sk-card-body-line short"></div>
            </div>
            <div class="sk-specs-grid">
              <div class="sk-bone sk-spec-cell"></div>
              <div class="sk-bone sk-spec-cell"></div>
              <div class="sk-bone sk-spec-cell"></div>
              <div class="sk-bone sk-spec-cell"></div>
              <div class="sk-bone sk-spec-cell"></div>
              <div class="sk-bone sk-spec-cell"></div>
            </div>
            <div class="sk-socials-grid">
              <div class="sk-bone sk-social-btn"></div>
              <div class="sk-bone sk-social-btn"></div>
              <div class="sk-bone sk-social-btn"></div>
              <div class="sk-bone sk-social-btn"></div>
            </div>
          </div>
        </div>
      </div>
    ) : pageType === 'commissions' ? (
      /* --- Commissions / Atelier Skeleton (/commissions) --- */
      <div class="sk-commissions-wrap">
        <div class="sk-bone sk-atelier-hero"></div>
        <div class="sk-filter-pills">
          <div class="sk-bone sk-nav-pill"></div>
          <div class="sk-bone sk-nav-pill"></div>
          <div class="sk-bone sk-nav-pill"></div>
        </div>
        <div class="sk-pricing-row">
          <div class="sk-bone sk-pricing-card"></div>
          <div class="sk-bone sk-pricing-card"></div>
          <div class="sk-bone sk-pricing-card"></div>
        </div>
        <div class="sk-gallery-grid">
          <div class="sk-bone sk-gallery-card"></div>
          <div class="sk-bone sk-gallery-card"></div>
          <div class="sk-bone sk-gallery-card"></div>
          <div class="sk-bone sk-gallery-card"></div>
        </div>
      </div>
    ) : pageType === 'about' ? (
      /* --- About / Directory Skeleton (/about & /members) --- */
      <div class="sk-about-wrap">
        <div class="sk-bone sk-about-hero"></div>
        <div class="sk-filter-pills">
          <div class="sk-bone sk-nav-pill"></div>
          <div class="sk-bone sk-nav-pill"></div>
          <div class="sk-bone sk-nav-pill"></div>
        </div>
        <div class="sk-editorial-row">
          <div class="sk-bone sk-editorial-col"></div>
          <div class="sk-bone sk-editorial-col"></div>
        </div>
      </div>
    ) : (
      /* --- Default Home Page Skeleton (/) --- */
      <div>
        <section class="sk-hero">
          <div class="sk-bone sk-hero-stage">
            <div class="sk-hero-center-badge"></div>
          </div>
          <div class="sk-bone sk-hero-headline"></div>
          <div class="sk-bone sk-hero-subline"></div>
        </section>

        <section class="sk-cards-grid">
          <div class="sk-bone sk-card">
            <div class="sk-card-top">
              <div class="sk-bone sk-avatar"></div>
              <div class="sk-card-title-col">
                <div class="sk-bone sk-title-line"></div>
                <div class="sk-bone sk-tag-line"></div>
              </div>
            </div>
            <div class="sk-bone sk-card-body-line"></div>
            <div class="sk-bone sk-card-body-line short"></div>
            <div class="sk-card-footer">
              <div class="sk-bone sk-badge-pill"></div>
              <div class="sk-bone sk-badge-pill"></div>
            </div>
          </div>

          <div class="sk-bone sk-card">
            <div class="sk-card-top">
              <div class="sk-bone sk-avatar"></div>
              <div class="sk-card-title-col">
                <div class="sk-bone sk-title-line"></div>
                <div class="sk-bone sk-tag-line"></div>
              </div>
            </div>
            <div class="sk-bone sk-card-body-line"></div>
            <div class="sk-bone sk-card-body-line short"></div>
            <div class="sk-card-footer">
              <div class="sk-bone sk-badge-pill"></div>
              <div class="sk-bone sk-badge-pill"></div>
            </div>
          </div>

          <div class="sk-bone sk-card">
            <div class="sk-card-top">
              <div class="sk-bone sk-avatar"></div>
              <div class="sk-card-title-col">
                <div class="sk-bone sk-title-line"></div>
                <div class="sk-bone sk-tag-line"></div>
              </div>
            </div>
            <div class="sk-bone sk-card-body-line"></div>
            <div class="sk-bone sk-card-body-line short"></div>
            <div class="sk-card-footer">
              <div class="sk-bone sk-badge-pill"></div>
              <div class="sk-bone sk-badge-pill"></div>
            </div>
          </div>
        </section>
      </div>
    )}
  </div>
</div>

<!-- Top Navigation Progress Indicator for Link Clicks -->
<div id="winest-nav-loader" class="winest-nav-loader" aria-hidden="true"></div>

<!-- Skeleton Controller Script -->
<script is:inline>
  (function () {
    const overlay = document.getElementById('winest-skeleton-overlay');
    const navLoader = document.getElementById('winest-nav-loader');

    function dismissSkeleton() {
      if (!overlay || overlay.classList.contains('is-dismissed')) return;
      overlay.classList.add('is-dismissed');
      if (navLoader) navLoader.classList.remove('is-active');

      setTimeout(function () {
        if (overlay && overlay.parentNode) {
          overlay.parentNode.removeChild(overlay);
        }
      }, 420);
    }

    // Dismiss only when all page assets (images, fonts, stylesheets) have loaded
    if (document.readyState === 'complete') {
      dismissSkeleton();
    } else {
      window.addEventListener('load', dismissSkeleton, { once: true });
      // Failsafe timer: Maximum 2.2s so it NEVER hangs forever on bad networks or broken external scripts
      setTimeout(dismissSkeleton, 2200);
    }

    // Link navigation feedback for slow mobile/3G networks
    document.addEventListener('click', function (e) {
      const link = e.target.closest('a');
      if (!link) return;
      const href = link.getAttribute('href');
      if (
        href &&
        href.startsWith('/') &&
        !href.startsWith('//') &&
        !href.startsWith('/#') &&
        !href.includes('#') &&
        link.target !== '_blank' &&
        !e.ctrlKey &&
        !e.metaKey &&
        !e.shiftKey
      ) {
        if (navLoader) navLoader.classList.add('is-active');
      }
    });
  })();
</script>
