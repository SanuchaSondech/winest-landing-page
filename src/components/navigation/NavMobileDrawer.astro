---
// NavMobileDrawer.astro - Mobile Slide-Over Navigation Drawer
import Icon from '../common/Icon.astro';

export interface NavLink {
  href: string;
  label: string;
  path?: string;
}

export interface Brand {
  name: string;
  sub: string;
  ariaHome: string;
  menuTitle: string;
}

export interface DrawerCta {
  href: string;
  label: string;
}

export interface Props {
  brand: Brand;
  navLinks: NavLink[];
  drawerCta?: DrawerCta;
  currentPath?: string;
}

const { brand, navLinks, currentPath = "/" } = Astro.props;
---

<div id="mobile-drawer" class="mobile-drawer" aria-hidden="true">
  <div class="drawer-backdrop" id="drawer-backdrop"></div>
  <aside class="drawer-content" role="dialog" aria-modal="true" aria-label={brand.menuTitle}>
    <!-- Drawer Header -->
    <div class="drawer-header">
      <div class="drawer-brand">
        <div class="drawer-logo-wrap">
          <img
            src="/logo/winest_logo_128.webp"
            alt={brand.name}
            width="32"
            height="32"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="drawer-brand-text">
          <span class="drawer-brand-name">{brand.name}</span>
          <span class="drawer-brand-sub">{brand.sub || "AGENCY"}</span>
        </div>
      </div>
      <button id="close-drawer-btn" class="close-drawer-btn" type="button" aria-label="ปิดเมนูนำทาง">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Navigation List with Theme-Aware Glass Cards -->
    <nav class="drawer-nav" aria-label="เมนูมือถือ">
      <ul class="drawer-list">
        {navLinks.map((item) => {
          const itemPath = item.path || item.href;
          const isActive =
            itemPath === "/" || itemPath === "/en"
              ? currentPath === itemPath || currentPath === `${itemPath}/`
              : currentPath.startsWith(itemPath);

          let iconName = "nav-home";
          if (itemPath.includes("members")) iconName = "nav-members";
          else if (itemPath.includes("commissions")) iconName = "nav-arts";
          else if (itemPath.includes("about")) iconName = "nav-about";

          return (
            <li>
              <a href={item.href} class={`drawer-link ${isActive ? "active" : ""}`}>
                <div class="drawer-link-left">
                  <span class="drawer-link-icon-box">
                    <Icon name={iconName} width="16" height="16" />
                  </span>
                  <span class="drawer-link-label">{item.label}</span>
                </div>
                <span class="drawer-link-chevron" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="9 18 15 12 9 6"></polyline>
                  </svg>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </aside>
</div>
