---
// Footer.astro - Minimalist Editorial Colophon Bar
import navData from '../../data/navigation.json';
import Icon from '../common/Icon.astro';
import '../../styles/footer.css';

const { brand } = navData;
const currentYear = new Date().getFullYear();
const isEn = Astro.props.lang === 'en' || Astro.url.pathname.startsWith('/en');

// Compact social icon links for footer baseline
const socials = [
  { id: "x", name: "X", url: "https://x.com/Winest_vt", icon: "x-twitter" },
  { id: "discord", name: "Discord", url: "https://discord.gg/TfAW5Eyuh4", icon: "discord" },
  { id: "youtube", name: "YouTube", url: "https://www.youtube.com/@Winest_Vt", icon: "youtube" },
  { id: "email", name: "Email", url: "mailto:winest.info@gmail.com", icon: "mail" }
];
---

<footer class="site-footer">
  <div class="container">
    <div class="minimal-colophon">
      <!-- Left: Brand Logo + Copyright -->
      <div class="colophon-left">
        <img 
          src="/logo/winest_logo_128.webp" 
          alt={brand.name} 
          width="20" 
          height="20" 
          class="colophon-logo" 
          loading="lazy" 
          decoding="async" 
        />
        <span class="colophon-brand-text">{brand.name} AGENCY</span>
        <span class="colophon-divider">/</span>
        <span class="colophon-copy">© {currentYear} {brand.copyright}</span>
      </div>

      <!-- Center: Compact Social Icons & Direct Link to /about -->
      <div class="colophon-center">
        <div class="colophon-social-icons">
          {socials.map((s) => (
            <a 
              href={s.url} 
              target={s.id !== 'email' ? '_blank' : undefined} 
              rel={s.id !== 'email' ? 'noopener noreferrer' : undefined}
              class={`colophon-icon-btn is-${s.id}`}
              aria-label={`ไปยัง ${s.name} ของ WINEST`}
              title={s.name}
            >
              <Icon name={s.icon} width="16" height="16" />
            </a>
          ))}
        </div>
        <span class="colophon-divider">/</span>
        <a href={isEn ? "/en/about" : "/about"} class="colophon-contact-link">
          <span>{isEn ? "Agency Contact & Collab" : "ติดต่อค่าย & Collab"}</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </a>
      </div>

      <!-- Right: Bangkok Time ICT + Back to Top -->
      <div class="colophon-right">
        <span class="colophon-time" id="bkkFooterTime">BANGKOK --:--:-- ICT</span>
        <span class="colophon-divider">/</span>
        <button type="button" class="colophon-top-link" id="footerBackToTop" aria-label={isEn ? "Back to top" : "เลื่อนขึ้นสู่ด้านบน"}>
          TOP ↑
        </button>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  function initMinimalFooter() {
    const clockEl = document.getElementById('bkkFooterTime');
    function updateClock() {
      if (!clockEl) return;
      try {
        const now = new Date();
        const options = { timeZone: 'Asia/Bangkok', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false };
        clockEl.textContent = `BANGKOK ${now.toLocaleTimeString('en-GB', options)} ICT`;
      } catch (e) {}
    }
    updateClock();
    if (!window.__footerClockTimer) {
      window.__footerClockTimer = setInterval(updateClock, 1000);
    }

    const topBtn = document.getElementById('footerBackToTop');
    if (topBtn && !topBtn.dataset.bound) {
      topBtn.dataset.bound = 'true';
      topBtn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMinimalFooter);
  } else {
    initMinimalFooter();
  }
  document.addEventListener('astro:page-load', initMinimalFooter);
</script>
