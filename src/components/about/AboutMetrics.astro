---
// AboutMetrics.astro - สถิติความสำเร็จและเสียงตอบรับ 4 ด้านของค่าย
export interface Metric {
  num: string;
  title: string;
  desc: string;
  tag?: string;
  badge?: string;
  author?: string;
}

export interface Props {
  kicker: string;
  meta: string;
  metrics: Metric[];
}

const { kicker, meta, metrics } = Astro.props;
---

<div class="editorial-col metrics-col">
  <div class="kicker-header-row">
    <span class="editorial-kicker">
      <span class="kicker-pip"></span>{kicker}
    </span>
  </div>
  
  <div class="metrics-list">
    {metrics.map((metric) => (
      <div class="metric-row">
        <span class="metric-num">{metric.num}</span>
        <div class="metric-content">
          <h3>{metric.title}</h3>
          {metric.author ? (
            <p class="metric-quote-text">
              {metric.desc}
              <span class="metric-author-tag">{metric.author}</span>
            </p>
          ) : (
            <p>{metric.desc}</p>
          )}
        </div>
        {metric.badge ? (
          <span class="metric-badge-score">
            <span class="badge-dot dot-score"></span>{metric.badge}
          </span>
        ) : (
          <span class="metric-unit-tag">{metric.tag}</span>
        )}
      </div>
    ))}
  </div>
</div>
