---
// HeroVideoFooter.astro - แถบควบคุมข้อมูลคลิปและการเล่นวิดีโอด้านล่างเวที 16:9
import Icon from '../common/Icon.astro';

export interface Props {
  playHint: string;
  trackTitle: string;
  trackSub: string;
  duration: string;
}

const { playHint, trackTitle, trackSub, duration } = Astro.props;
const isEn = Astro.url.pathname.startsWith('/en');
---

<div class="video-overlay-ui">
  <!-- Center Controls (Play Button & Hint Pill) -->
  <div class="video-center-controls">
    <button 
      class="play-btn-circle is-pending" 
      id="play-trailer-btn" 
      type="button"
      aria-label={isEn ? "WINEST promotional video (Coming soon)" : "วิดีโอโปรโมตค่าย WINEST (เร็ว ๆ นี้)"}
      title={isEn ? "Promotional video in production" : "วิดีโอเปิดตัวอยู่ระหว่างการผลิต"}
    >
      <Icon name="play" class="play-triangle" />
    </button>
    <div class="frosted-hint-pill is-pending">
      <span class="play-hint-dot is-pending"></span>
      <span class="play-hint">{playHint}</span>
    </div>

    <!-- Floating Tooltip / Toast Notification -->
    <div 
      class="hero-video-toast" 
      id="heroVideoToast" 
      role="status" 
      aria-live="polite" 
      aria-hidden="true"
    >
      <span class="toast-dot" aria-hidden="true"></span>
      <span class="toast-text">
        {isEn 
          ? "🎬 WINEST promotional video is in production. Coming soon!" 
          : "🎬 วิดีโอโปรโมตค่าย WINEST กำลังอยู่ระหว่างการผลิต เตรียมรับชมได้เร็ว ๆ นี้!"}
      </span>
    </div>
  </div>

  <!-- Footer Information Bar with Clean Frosted Glass -->
  <div class="video-footer-info">
    <div class="track-info">
      <span class="track-title">{trackTitle}</span>
      <span class="track-sub">{trackSub}</span>
    </div>
    <div class="video-footer-meta">
      <div class="duration-badge">
        <span class="rec-dot"></span>
        <span>{duration}</span>
      </div>
      <!-- Audio Waveform SVG Animation -->
      <div class="waveform" aria-hidden="true">
        <span class="bar b1"></span>
        <span class="bar b2"></span>
        <span class="bar b3"></span>
        <span class="bar b4"></span>
        <span class="bar b5"></span>
        <span class="bar b6"></span>
      </div>
    </div>
  </div>
</div>
