---
// HeroVideo.astro - ส่วน 1: พื้นที่สำหรับคลิป 16:9 (Main Stage Showcase)
import homeData from "../../data/home.json";
import homeEnData from "../../data/home.en.json";
import HeroWonderlandSvg from "./HeroWonderlandSvg.astro";
import HeroVideoFooter from "./HeroVideoFooter.astro";
import "../../styles/hero.css";

const isEn = Astro.url.pathname.startsWith('/en');
const currentData = isEn ? homeEnData : homeData;
const { hero } = currentData;
---

<section class="hero-section" id="hero">
  <div class="container">
    <!-- 16:9 Video Showcase Screen Frame (Zero-Clutter Above-the-Fold Canvas) -->
    <div class="theater-stage-container">
      <div class="video-canvas-ratio" id="video-wrapper">
        <!-- SVG Vector Background for Amusement Park Scene -->
        <HeroWonderlandSvg />

        <!-- Video Overlay UI (Play Controls & Frosted Footer Bar) -->
        <HeroVideoFooter
          playHint={hero.playHint}
          trackTitle={hero.trackTitle}
          trackSub={hero.trackSub}
          duration={hero.duration}
        />
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    function setupHeroControls() {
      const playBtn = document.getElementById("play-trailer-btn");
      const toast = document.getElementById("heroVideoToast");
      if (!playBtn || !toast) return;

      let toastTimer = null;

      function showToast() {
        if (toastTimer) clearTimeout(toastTimer);
        toast.classList.add("is-visible");
        toast.setAttribute("aria-hidden", "false");

        toastTimer = setTimeout(() => {
          toast.classList.remove("is-visible");
          toast.setAttribute("aria-hidden", "true");
        }, 3400);
      }

      playBtn.addEventListener("click", (e) => {
        e.preventDefault();
        showToast();
      });

      toast.addEventListener("click", () => {
        if (toastTimer) clearTimeout(toastTimer);
        toast.classList.remove("is-visible");
        toast.setAttribute("aria-hidden", "true");
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupHeroControls);
    } else {
      setupHeroControls();
    }
    document.addEventListener("astro:page-load", setupHeroControls);
  })();
</script>
