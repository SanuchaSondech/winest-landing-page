---
// MembersSection.astro - ส่วนสมาชิก VTuber (เชื่อมต่อข้อมูลจริง 2 สมาชิกที่เปิดตัวทางการในรุ่น 1: GENESIS)
import homeData from '../../data/home.json';
import membersData from '../../data/members.json';
import MemberCard from './MemberCard.astro';
import MemberSliderControl from './MemberSliderControl.astro';
import Icon from '../common/Icon.astro';
import '../../styles/members.css';

interface Props {
  data?: any;
}

const { data } = Astro.props;
const membersSection = data || homeData.membersSection;
const isEn = Astro.url.pathname.startsWith('/en');
const membersLink = isEn ? '/en/members' : '/members';
const ctaBanner = membersSection?.ctaBanner || homeData.membersSection.ctaBanner;
// ดึงข้อมูลจริงเฉพาะสมาชิกที่เปิดตัวแล้ว (Gen 1: Yunaria Zayu และ Karake)
const activeTalents = membersData.talents.filter((t) => !t.isTeaser);
---

<section class="members-section" id="members">
  <div class="container">
    <!-- Section Header Block (Editorial Alignment) -->
    <div class="members-header-block reveal-init reveal-header">
      <div class="section-title-wrap">
        <h2 class="section-headline">
          {membersSection.titlePrefix} <span class="accent-color">{membersSection.titleHighlight}</span> {membersSection.titleSuffix}
        </h2>
        <p class="section-subheadline">{membersSection.desc}</p>
      </div>
    </div>

    <!-- Members Carousel Container (data-scroll-enabled="false" ตามที่กำหนด ปิดการเลื่อนชั่วคราว) -->
    <div 
      class="members-carousel-container reveal-init reveal-card stagger-2 is-static" 
      id="membersCarousel" 
      data-scroll-enabled="false"
      role="region" 
      aria-roledescription="carousel" 
      aria-label="สมาชิก VTuber"
    >
      <!-- Carousel Viewport -->
      <div class="members-carousel-viewport" id="membersViewport" tabindex="0" data-scroll-enabled="false">
        <div class="members-grid is-carousel" id="membersTrack">
          <!-- Primary Group: 2 สมาชิกทางการ (Yunaria Zayu & Karake) -->
          <div class="members-ticker-group">
            {activeTalents.map((talent, index) => (
              <MemberCard talent={talent} index={index} />
            ))}
          </div>
        </div>
      </div>

      <!-- Bottom Slider Control (คงโค้ดไว้ แต่ซ่อนเมื่ออยู่ในโหมด scroll-enabled="false") -->
      <MemberSliderControl />
    </div>

    <!-- Members Editorial CTA Bar (Centered Harmonious Finale) -->
    <div class="members-cta-bar reveal-init reveal-card stagger-2">
      <div class="cta-center-stack">
        <h3 class="cta-title">{ctaBanner.title}</h3>
        <div class="cta-bar-action">
          <a href={membersLink} class="roster-magnetic-btn" id="rosterMagneticBtn" aria-label={ctaBanner.buttonText || (isEn ? "View Full Talent Roster" : "เข้าชมโปรไฟล์สมาชิกทั้งหมด")}>
            <!-- Raycast cursor spotlight layer -->
            <span class="btn-spotlight" aria-hidden="true"></span>
            
            <!-- Specular rim light -->
            <span class="btn-specular-rim" aria-hidden="true"></span>

            <!-- Content container -->
            <span class="btn-content-wrap">
              <span class="btn-text">{ctaBanner.buttonText || (isEn ? "View Full Talent Roster" : "เข้าชมโปรไฟล์สมาชิกทั้งหมด")}</span>

              <!-- Kinetic Arrow Lens -->
              <span class="btn-arrow-lens" aria-hidden="true">
                <Icon name="arrow-diagonal" class="arrow-svg" width="16" height="16" />
              </span>
            </span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Members Interactive Controller: Carousel Touch & Drag + Magnetic CTA Spotlight -->
<script>
  import { initMembersSection } from '../../scripts/members-carousel.js';

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMembersSection);
  } else {
    initMembersSection();
  }
  document.addEventListener('astro:page-load', initMembersSection);
</script>
