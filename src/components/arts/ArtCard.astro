---
// ArtCard.astro - การ์ดแสดงผลงานบริการงานศิลป์ (Editorial Minimalist: ลำดับสายตาคมชัด ไม่ยัดป้ายซ้อนป้าย)
import Icon from '../common/Icon.astro';

export interface ArtItem {
  id: string;
  badge: string;
  isComingSoon?: boolean;
  title: string;
  desc: string;
  specs: string[];
  image?: string;
}

export interface Props {
  item: ArtItem;
  index: number;
}

const { item, index } = Astro.props;
const isEn = Astro.url.pathname.startsWith('/en');
const commissionsLink = isEn ? '/en/commissions' : '/commissions';

const shortChipsMap: Record<string, string[]> = isEn
  ? {
      "service-01": ["Character Design", "Key Visuals & Art", "4K Stream Backgrounds"],
      "service-02": ["Hair & Cloth Physics", "XYZ Head & Body Rig", "Full Expression Sets"],
      "service-03": ["Vocal Pitch Tuning", "Music Balancing", "Track Mastering"],
      "art-01": ["Character Design", "Key Visuals & Art", "4K Stream Backgrounds"],
      "art-02": ["Hair & Cloth Physics", "XYZ Head & Body Rig", "Full Expression Sets"],
      "art-03": ["Vocal Pitch Tuning", "Music Balancing", "Track Mastering"]
    }
  : {
      "service-01": ["คาแรกเตอร์ดีไซน์", "วาดคน & ภาพโปรโมต", "วาดฉากหลัง 4K"],
      "service-02": ["ฟิสิกส์ผม & เสื้อผ้า", "การขยับศีรษะ XYZ", "เซ็ตอัปอารมณ์สีหน้า"],
      "service-03": ["จูนเสียงร้องระดับโปร", "มิกซ์บาลานซ์ดนตรี", "มาสเตอริ่งแทร็ก"],
      "art-01": ["คาแรกเตอร์ดีไซน์", "วาดคน & ภาพโปรโมต", "วาดฉากหลัง 4K"],
      "art-02": ["ฟิสิกส์ผม & เสื้อผ้า", "การขยับศีรษะ XYZ", "เซ็ตอัปอารมณ์สีหน้า"],
      "art-03": ["จูนเสียงร้องระดับโปร", "มิกซ์บาลานซ์ดนตรี", "มาสเตอริ่งแทร็ก"]
    };

const chips = shortChipsMap[item.id] || item.specs?.slice(0, 3) || [];

const conceptArts: Record<string, string> = {
  'service-01': 'arts/art-concept-1',
  'service-02': 'arts/art-concept-2',
  'service-03': 'arts/art-concept-3',
  'art-01': 'arts/art-concept-1',
  'art-02': 'arts/art-concept-2',
  'art-03': 'arts/art-concept-3',
};
const conceptArtName = conceptArts[item.id] || 'arts/art-concept-1';
---

<article class={`art-preview-card ${item.isComingSoon ? 'is-coming-soon-card' : ''} reveal-init reveal-card stagger-${Math.min(index + 1, 4)}`} data-index={index}>
  <!-- Visual Stage: 16:9 Aspect Ratio -->
  <div class="art-visual-stage">
    {item.isComingSoon ? (
      <div class="art-coming-soon-stage">
        <span class="coming-soon-banner-text">COMING SOON</span>
      </div>
    ) : item.image ? (
      <img 
        src={item.image} 
        alt={item.title} 
        class="art-visual-media" 
        loading="lazy" 
        decoding="async" 
        width="640"
        height="360"
      />
    ) : (
      <div class="art-vector-wrapper">
        {conceptArtName && <Icon name={conceptArtName} class="art-vector-art" />}
      </div>
    )}

    <!-- Single Category Badge on Visual Stage -->
    <div class="art-category-pill">
      <span class="pill-dot"></span>
      <span>{item.badge}</span>
    </div>
  </div>

  <!-- Content Body: Clear Hierarchy -->
  <div class="art-detail-body">
    <!-- Level 1: Title -->
    <div class="art-title-row">
      <h3 class="art-service-title">{item.title}</h3>
    </div>

    <!-- Level 2: Concise Description -->
    <p class="art-desc-text">{item.desc}</p>

    <!-- Level 3: Feature Highlights -->
    <div class="art-chips-row">
      {chips.map((chip) => (
        <span class="art-chip-tag">{chip}</span>
      ))}
    </div>

    <!-- Level 4: Clear Footer -->
    <div class="art-card-footer">
      {item.isComingSoon ? (
        <span class="art-license-indicator is-soon">
          <span class="soon-pulse-dot" aria-hidden="true"></span>
          <span>{isEn ? "Available in Phase 2" : "เปิดรับงานเฟส 2"}</span>
        </span>
      ) : (
        <>
          <span class="art-license-indicator">
            <Icon name="check" class="license-check-icon" width="13" height="13" />
            <span>{isEn ? "Commercial Ready" : "สิทธิ์เชิงพาณิชย์ครบวงจร"}</span>
          </span>

          <a href={commissionsLink} class="art-detail-link" aria-label={isEn ? `View details for ${item.title}` : `ดูรายละเอียดบริการ ${item.title}`}>
            <span>{isEn ? "Details" : "รายละเอียด"}</span>
            <Icon name="chevron-right" width="13" height="13" />
          </a>
        </>
      )}
    </div>
  </div>
</article>
