---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  schema?: Record<string, any> | Record<string, any>[];
  lang?: "th" | "en";
}

const {
  title = "WINEST - ค่าย VTuber และบริการงานวาดครบวงจร",
  description = "WINEST ค่าย VTuber และสตูดิโอสร้างสรรค์งานอาร์ตระดับพรีเมียม รับออกแบบโมเดล Live2D, Character Sheet, สติกเกอร์ และฉากสตรีมมิ่ง",
  image = "/logo/winest_logo.png",
  type = "website",
  schema,
  lang,
} = Astro.props;

import HamsterScrollSlider from "../components/common/HamsterScrollSlider.astro";

const siteUrl = "https://winest.studio";
const pageLang = lang || (Astro.url && Astro.url.pathname.startsWith("/en") ? "en" : "th");
const canonicalURL = Astro.url ? new URL(Astro.url.pathname, siteUrl).href : siteUrl;
const formattedImage = image.startsWith("http") ? image : `${siteUrl}${image.startsWith("/") ? "" : "/"}${image}`;

// Compute hreflang alternates
const currentPath = Astro.url ? Astro.url.pathname : "/";
const thPath = currentPath.replace(/^\/en(\/|$)/, "/") || "/";
const enPath = currentPath.startsWith("/en") ? currentPath : `/en${currentPath === "/" ? "" : currentPath}`;

// Global Base Schema.org Graph
const jsonLdGraph = [
  {
    "@type": "Organization",
    "@id": "https://winest.studio/#organization",
    "name": "WINEST",
    "url": "https://winest.studio",
    "logo": "https://winest.studio/logo/winest_logo.png",
    "description": "ค่าย VTuber และสตูดิโองานวาด คาแรคเตอร์ชีท สติกเกอร์ และฉากสตรีมมิ่ง",
    "sameAs": [
      "https://x.com/Winest_vt",
      "https://youtube.com/@winest_official"
    ]
  },
  {
    "@type": "WebSite",
    "@id": "https://winest.studio/#website",
    "url": "https://winest.studio",
    "name": "WINEST",
    "publisher": { "@id": "https://winest.studio/#organization" }
  },
  ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])
];

const structuredDataString = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": jsonLdGraph
});
---

<!doctype html>
<html lang={pageLang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="WINEST, ค่าย VTuber, วาดรูป VTuber, Live2D, รับวาด Character Sheet, สติกเกอร์ LINE, ฉากสตรีม, VTuber Agency Thailand, รับวาดรูปคอมมิชชัน, Kenelix Studio"
    />
    <meta name="author" content="WINEST Production" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="theme-color" content="#0a0c16" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="th" href={`${siteUrl}${thPath}`} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}${enPath}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/`} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={formattedImage} />
    <meta property="og:site_name" content="WINEST" />
    <meta property="og:locale" content={pageLang === "en" ? "en_US" : "th_TH"} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@Winest_vt" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={formattedImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/logo/winest_logo_128.png" />
    <link rel="apple-touch-icon" href="/logo/winest_logo_128.png" />

    <!-- Google Fonts Preconnect & Parallel Stylesheet -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Prompt:wght@400;500;600;700;800&family=Sarabun:wght@400;500;600&display=swap"
    />

    <!-- JSON-LD Structured Data for Rich Search Snippets -->
    <script type="application/ld+json" set:html={structuredDataString} />

    <!-- Theme Initialization Script (Prevent FOUT) -->
    <script is:inline>
      (function () {
        const savedTheme = localStorage.getItem("winest-theme") || "dark";
        document.documentElement.setAttribute("data-theme", savedTheme);
      })();
    </script>
  </head>
  <body>
    <!-- Amusement Park Background Decor Pattern & Chromatic Glass Ambient Orbs -->
    <div class="park-map-bg" aria-hidden="true"></div>
    <div class="glass-ambient-orbs" aria-hidden="true">
      <div class="glass-orb orb-1"></div>
      <div class="glass-orb orb-2"></div>
      <div class="glass-orb orb-3"></div>
    </div>

    <slot />

    <!-- Cute Kawaii Hamster Long-Slider Progress Engine -->
    <HamsterScrollSlider />

    <!-- Theme Toggle Handler -->
    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        const toggleBtn = document.getElementById("theme-toggle-btn");
        const mobileToggleBtn = document.getElementById(
          "mobile-theme-toggle-btn",
        );

        function switchTheme() {
          const currentTheme =
            document.documentElement.getAttribute("data-theme");
          const nextTheme = currentTheme === "light" ? "dark" : "light";
          document.documentElement.setAttribute("data-theme", nextTheme);
          localStorage.setItem("winest-theme", nextTheme);
        }

        if (toggleBtn) toggleBtn.addEventListener("click", switchTheme);
        if (mobileToggleBtn)
          mobileToggleBtn.addEventListener("click", switchTheme);
      });
    </script>

    <!-- Scroll Reveal Motion Engine -->
    <script src="../scripts/scroll-reveal.js"></script>
  </body>
</html>
