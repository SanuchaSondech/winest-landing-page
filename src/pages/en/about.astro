---
// src/pages/en/about.astro - WINEST Official Contact Channels & Directory (English Version)
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import Icon from "../../components/common/Icon.astro";
import commissionsData from "../../data/commissions.en.json";
import aboutData from "../../data/about.json";
import "../../styles/global.css";
import "../../styles/about-page.css";

const { atelier } = commissionsData;
const content = aboutData.en;

const contactSchema = {
  "@type": "ContactPage",
  "@id": "https://winest.studio/en/about#webpage",
  "url": "https://winest.studio/en/about",
  "name": content.metaTitle,
  "description": content.metaDescription,
  "isPartOf": { "@id": "https://winest.studio/#website" },
  "about": { "@id": "https://winest.studio/#organization" }
};
---

<Layout
  title={content.metaTitle}
  description={content.metaDescription}
  schema={contactSchema}
  lang="en"
>
  <Navbar lang="en" />

  <main class="about-page-main">
    <div class="about-container">

      <!-- ============================================================
           HERO MASTHEAD: Concise Title & In-Page Anchors
           ============================================================ -->
      <header class="about-hero-section">
        <h1 class="about-hero-title">{content.hero.title}</h1>

        <!-- Quick Navigation Anchors -->
        <nav class="about-nav-anchors" aria-label="Contact page quick anchors">
          <a href="#agency-contact" class="about-anchor-pill">
            <Icon name="x-twitter" width="14" height="14" />
            <span>{content.hero.anchors.agency}</span>
          </a>
          <a href="#hiring-contact" class="about-anchor-pill">
            <Icon name="grid" width="14" height="14" />
            <span>{content.hero.anchors.studio}</span>
          </a>
          <a href="#policies" class="about-anchor-pill">
            <Icon name="check" width="14" height="14" />
            <span>{content.hero.anchors.policies}</span>
          </a>
        </nav>
      </header>

      <div class="about-divider" aria-hidden="true"></div>

      <!-- ============================================================
           SECTION 1: Agency & VTuber Collaborations
           ============================================================ -->
      <section class="about-zone" id="agency-contact">
        <div class="zone-header-block">
          <span class="zone-tag-kicker">{content.agency.kicker}</span>
          <h2 class="zone-main-heading">{content.agency.title}</h2>
          <p class="zone-subtext">{content.agency.desc}</p>
        </div>

        <div class="zone-cards-grid-2">
          <!-- Channel 1: X (Twitter) -->
          <a
            href="https://x.com/Winest_vt"
            target="_blank"
            rel="noopener noreferrer"
            class="unified-card"
          >
            <div class="card-top-row">
              <div class="card-icon-frame" aria-hidden="true">
                <Icon name="x-twitter" width="22" height="22" />
              </div>
              <div class="card-title-group">
                <h3>{content.agency.cardX.title}</h3>
                <span class="card-sub-tag">{content.agency.cardX.tag}</span>
              </div>
            </div>
            <p class="card-body-text">{content.agency.cardX.desc}</p>
            <span class="card-action-row">
              <span>{content.agency.cardX.action}</span>
              <Icon name="arrow-diagonal" width="14" height="14" />
            </span>
          </a>

          <!-- Channel 2: Discord Community -->
          <a
            href="https://discord.gg"
            target="_blank"
            rel="noopener noreferrer"
            class="unified-card"
          >
            <div class="card-top-row">
              <div class="card-icon-frame" aria-hidden="true">
                <Icon name="discord" width="22" height="22" />
              </div>
              <div class="card-title-group">
                <h3>{content.agency.cardDiscord.title}</h3>
                <span class="card-sub-tag">{content.agency.cardDiscord.tag}</span>
              </div>
            </div>
            <p class="card-body-text">{content.agency.cardDiscord.desc}</p>
            <span class="card-action-row">
              <span>{content.agency.cardDiscord.action}</span>
              <Icon name="arrow-diagonal" width="14" height="14" />
            </span>
          </a>
        </div>
      </section>

      <div class="about-divider" aria-hidden="true"></div>

      <!-- ============================================================
           SECTION 2: Creative Studio & Commissions (Kenelix Studio)
           ============================================================ -->
      <section class="about-zone" id="hiring-contact">
        <div class="zone-header-block">
          <span class="zone-tag-kicker">{content.studio.kicker}</span>
          <h2 class="zone-main-heading">{content.studio.title}</h2>
          <p class="zone-subtext">{content.studio.desc}</p>
        </div>

        <div class="zone-cards-grid-2">
          <!-- Option A: View Rates & Portfolio -->
          <a
            href="/en/commissions"
            class="unified-card"
          >
            <div class="card-top-row">
              <div class="card-icon-frame" aria-hidden="true">
                <Icon name="grid" width="22" height="22" />
              </div>
              <div class="card-title-group">
                <h3>{content.studio.cardRates.title}</h3>
                <span class="card-sub-tag">{content.studio.cardRates.tag}</span>
              </div>
            </div>
            <p class="card-body-text">{content.studio.cardRates.desc}</p>
            <span class="card-solid-btn">
              <span>{content.studio.cardRates.action}</span>
              <Icon name="arrow-right" width="15" height="15" />
            </span>
          </a>

          <!-- Option B: Open Discord Ticket -->
          <a
            href={atelier.discordUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="unified-card"
          >
            <div class="card-top-row">
              <div class="card-icon-frame" aria-hidden="true">
                <Icon name="discord" width="22" height="22" />
              </div>
              <div class="card-title-group">
                <h3>{content.studio.cardTicket.title}</h3>
                <span class="card-sub-tag">{content.studio.cardTicket.tag}</span>
              </div>
            </div>
            <p class="card-body-text">{content.studio.cardTicket.desc}</p>
            <span class="card-outline-btn">
              <Icon name="discord" width="16" height="16" />
              <span>{content.studio.cardTicket.action}</span>
            </span>
          </a>
        </div>
      </section>

      <div class="about-divider" aria-hidden="true"></div>

      <!-- ============================================================
           SECTION 3: Guidelines & Policies
           ============================================================ -->
      <section class="about-zone" id="policies">
        <div class="zone-header-block">
          <span class="zone-tag-kicker">{content.policies.kicker}</span>
          <h2 class="zone-main-heading">{content.policies.title}</h2>
          <p class="zone-subtext">{content.policies.desc}</p>
        </div>

        <div class="zone-cards-grid-3">
          {content.policies.items.map((g: any) => (
            <article class="unified-card">
              <h3 class="policy-card-title">{g.title}</h3>
              <p class="policy-body-text">{g.desc}</p>
            </article>
          ))}
        </div>
      </section>

    </div>
  </main>

  <Footer />

  <script>
    document.querySelectorAll('.about-anchor-pill[href^="#"]').forEach((anchor) => {
      anchor.addEventListener('click', (e) => {
        const targetId = anchor.getAttribute('href');
        if (!targetId || targetId === '#') return;
        const targetEl = document.querySelector(targetId);
        if (targetEl) {
          e.preventDefault();
          targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  </script>
</Layout>
