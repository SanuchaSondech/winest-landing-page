---
// src/pages/about.astro - WINEST Official About, Collaboration & Guidelines
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/common/Icon.astro";
import "../styles/global.css";
import "../styles/about-page.css";

const pillars = [
  {
    title: "Virtual Talent Roster",
    desc: "ส่งเสริมและสนับสนุนทาเลนต์ VTuber ของค่าย ให้ได้แสดงเอกลักษณ์ ความสามารถ และสร้างความสุขให้กับคอมมิวนิตี้อย่างเต็มศักยภาพ",
  },
  {
    title: "Creative Production",
    desc: "ยกระดับคุณภาพงานโปรดักชันระดับพรีเมียม ทั้งการออกแบบตัวละคร (Character Design) งานวาดฉาก และการริกโมเดล Live2D ให้มีมิติเป็นธรรมชาติ",
  },
  {
    title: "Community & Safe Space",
    desc: "มุ่งมั่นสร้างพื้นที่ปลอดภัยและอบอุ่นสำหรับแฟนคลับ ครีเอเตอร์ และผู้ติดตามทุกคน ได้ร่วมพูดคุยและสร้างสรรค์ความทรงจำที่ดีไปด้วยกัน",
  },
];

const guidelines = [
  {
    title: "แนวทางผลงานแฟนอาร์ต (Fan Art)",
    desc: "ยินดีและสนับสนุนให้แฟนคลับสร้างสรรค์และเผยแพร่ผลงานเพื่อสนับสนุนทาเลนต์ได้อย่างอิสระ สำหรับการใช้งานที่ไม่ใช่เชิงพาณิชย์",
  },
  {
    title: "ความปลอดภัยและความเป็นส่วนตัว (Safety & Privacy)",
    desc: "ขอความร่วมมือในการเคารพพื้นที่ส่วนตัวของทาเลนต์ ไม่สืบค้นหรือเผยแพร่ข้อมูลตัวตนจริง (IRL) และรักษาบรรยากาศการมีส่วนร่วมที่สร้างสรรค์และสุภาพ",
  },
  {
    title: "การว่าจ้างและลิขสิทธิ์เชิงพาณิชย์ (Commercial Terms)",
    desc: "งานสั่งทำโมเดลและภาพประกอบจากสตูดิโอจะได้รับสิทธิ์การใช้งานเชิงพาณิชย์ตามที่ตกลง สามารถตรวจสอบรายละเอียดเงื่อนไขและคิวงานได้ที่หน้าคอมมิชชัน",
  },
];
---

<Layout
  title="About WINEST - เกี่ยวกับค่ายและการติดต่อ"
  description="เรื่องราวของ WINEST ค่ายเวอร์ชวลครีเอเตอร์และสตูดิโอสร้างสรรค์คอนเทนต์ ช่องทางการติดต่อประสานงาน Collab และแนวทางคอมมิวนิตี้"
>
  <Navbar />

  <main class="about-page-main">
    <div class="about-container">

      <!-- ============================================================
           HERO MASTHEAD: Human Editorial Typography
           ============================================================ -->
      <header class="about-masthead">
        <span class="about-kicker">About WINEST</span>
        <h1 class="about-headline">
          โปรเจกต์เวอร์ชวลครีเอเตอร์<br class="hidden-mobile" />
          และสตูดิโอสร้างสรรค์คอนเทนต์
        </h1>
        <p class="about-lead">
          WINEST คือพื้นที่รวมตัวของ VTuber ครีเอเตอร์ และทีมงานสร้างสรรค์ที่มุ่งมั่นนำเสนองานโปรดักชันคุณภาพ ควบคู่ไปกับการสร้างคอมมิวนิตี้ที่อบอุ่นและเป็นมิตรในโลกเวอร์ชวล
        </p>

        <!-- Minimal Section Dock (Clean text links, no pill spam) -->
        <nav class="about-dock-nav" aria-label="สารบัญหน้า About">
          <a href="#about-pillars" class="dock-nav-link">วิสัยทัศน์ & พันธกิจ</a>
          <span class="dock-sep">/</span>
          <a href="#contact-collab" class="dock-nav-link">ติดต่อค่าย & Collab</a>
          <span class="dock-sep">/</span>
          <a href="#studio-commissions" class="dock-nav-link">สตูดิโอ & คอมมิชชัน</a>
          <span class="dock-sep">/</span>
          <a href="#community-guidelines" class="dock-nav-link">แนวทางชุมชน</a>
        </nav>
      </header>

      <div class="about-divider" aria-hidden="true"></div>

      <!-- ============================================================
           SECTION 1: Core Pillars (Authentic Editorial 3-Col Split)
           ============================================================ -->
      <section class="about-section" id="about-pillars">
        <div class="section-intro">
          <h2 class="section-title">วิสัยทัศน์และการทำงาน</h2>
          <p class="section-desc">หัวใจสำคัญในการขับเคลื่อนค่ายและสตูดิโอ WINEST</p>
        </div>

        <div class="pillars-grid">
          {pillars.map((pillar, idx) => (
            <article class="pillar-card">
              <span class="pillar-index">0{idx + 1}</span>
              <h3 class="pillar-title">{pillar.title}</h3>
              <p class="pillar-desc">{pillar.desc}</p>
            </article>
          ))}
        </div>
      </section>

      <div class="about-divider" aria-hidden="true"></div>

      <!-- ============================================================
           SECTION 2: Contact & Collaboration (Clean 2-Col Lanes)
           ============================================================ -->
      <section class="about-section" id="contact-collab">
        <div class="section-intro">
          <h2 class="section-title">ติดต่อค่าย และความร่วมมือ</h2>
          <p class="section-desc">
            สำหรับเสนอร่วมงาน Collab สตรีมเกม/เพลง, งานสปอนเซอร์แบรนด์ หรือติดต่อพูดคุยกับทีมงาน
          </p>
        </div>

        <div class="contact-duet-grid">
          <!-- X (Twitter) -->
          <a
            href="https://x.com/Winest_vt"
            target="_blank"
            rel="noopener noreferrer"
            class="contact-channel-card"
          >
            <div class="channel-card-header">
              <div class="channel-icon-wrap" aria-hidden="true">
                <Icon name="x-twitter" width="22" height="22" />
              </div>
              <div>
                <h3 class="channel-name">X (Twitter)</h3>
                <span class="channel-handle">@Winest_vt</span>
              </div>
            </div>
            <p class="channel-desc">
              ติดตามประกาศทางการ ตารางกิจกรรม และสามารถส่ง Direct Message (DM) เพื่อเสนอข้อตกลงเบื้องต้นได้อย่างสะดวกรวดเร็ว
            </p>
            <span class="channel-action">
              <span>ไปยังบัญชี @Winest_vt</span>
              <Icon name="arrow-diagonal" width="14" height="14" />
            </span>
          </a>

          <!-- Discord -->
          <a
            href="https://discord.gg"
            target="_blank"
            rel="noopener noreferrer"
            class="contact-channel-card"
          >
            <div class="channel-card-header">
              <div class="channel-icon-wrap" aria-hidden="true">
                <Icon name="discord" width="22" height="22" />
              </div>
              <div>
                <h3 class="channel-name">Discord Server</h3>
                <span class="channel-handle">WINEST Official Community</span>
              </div>
            </div>
            <p class="channel-desc">
              เข้าร่วมพื้นที่คอมมิวนิตี้ทางการสำหรับแฟนคลับ และช่องทางติดต่อห้อง <em>#collab-inquiries</em> เพื่อนัดหมายสตรีมร่วมกัน
            </p>
            <span class="channel-action">
              <span>เข้าร่วม Discord</span>
              <Icon name="arrow-diagonal" width="14" height="14" />
            </span>
          </a>
        </div>
      </section>

      <div class="about-divider" aria-hidden="true"></div>

      <!-- ============================================================
           SECTION 3: Studio & Production Commissions (Bridge to /commissions)
           ============================================================ -->
      <section class="about-section" id="studio-commissions">
        <div class="studio-bridge-card">
          <div class="studio-bridge-content">
            <span class="studio-bridge-kicker">Creative Production & Commissions</span>
            <h2 class="studio-bridge-title">ต้องการสั่งทำโมเดล Live2D หรือวาดฉากสตรีมมิ่ง?</h2>
            <p class="studio-bridge-desc">
              สตูดิโอ WINEST และ Kenelix Studio ให้บริการงานโปรดักชันระดับมืออาชีพ ทั้งงานวาดคาแรกเตอร์ดีไซน์, ริกโมเดล Live2D พร้อมฟิสิกส์สมจริง และวาดฉากสตรีมมิ่ง 4K สามารถดูตัวอย่างผลงานจริง วิดีโอทดสอบการเคลื่อนไหว และเช็กคิวงานได้ที่หน้ารับงานคอมมิชชัน
            </p>
          </div>
          <div class="studio-bridge-action">
            <a href="/commissions" class="studio-primary-btn">
              <span>ไปยังหน้ารับงานคอมมิชชัน</span>
              <Icon name="arrow-right" width="16" height="16" />
            </a>
          </div>
        </div>
      </section>

      <div class="about-divider" aria-hidden="true"></div>

      <!-- ============================================================
           SECTION 4: Community Guidelines & Policies (Clean 3-Col)
           ============================================================ -->
      <section class="about-section" id="community-guidelines">
        <div class="section-intro">
          <h2 class="section-title">แนวทางชุมชนและข้อกำหนด</h2>
          <p class="section-desc">
            แนวทางปฏิบัติเพื่อให้การอยู่ร่วมกันในคอมมิวนิตี้เป็นไปอย่างสร้างสรรค์และปลอดภัย
          </p>
        </div>

        <div class="guidelines-grid">
          {guidelines.map((item) => (
            <article class="guideline-card">
              <h3 class="guideline-title">{item.title}</h3>
              <p class="guideline-desc">{item.desc}</p>
            </article>
          ))}
        </div>
      </section>

    </div>
  </main>

  <Footer />

  <script>
    // Smooth scrolling for in-page anchors
    document.querySelectorAll('.dock-nav-link[href^="#"]').forEach((anchor) => {
      anchor.addEventListener('click', (e) => {
        const targetId = anchor.getAttribute('href');
        if (!targetId || targetId === '#') return;
        const targetEl = document.querySelector(targetId);
        if (targetEl) {
          e.preventDefault();
          targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  </script>
</Layout>
