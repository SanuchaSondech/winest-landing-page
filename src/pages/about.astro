---
// src/pages/about.astro - WINEST Official Contact Channels & Directory
// Unified Design Architecture: 1. ติดต่อค่าย | 2. ติดต่องานคอมมิชชัน | 3. นโยบาย
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/common/Icon.astro";
import commissionsData from "../data/commissions.json";
import "../styles/global.css";
import "../styles/about-page.css";

const { atelier } = commissionsData;

const guidelines = [
  {
    title: "ผลงานแฟนอาร์ต (Fan Art)",
    desc: "ยินดีและสนับสนุนให้แฟนคลับสร้างสรรค์และเผยแพร่ผลงานเพื่อสนับสนุนทาเลนต์ได้อย่างอิสระ สำหรับการใช้งานที่ไม่ใช่เชิงพาณิชย์",
  },
  {
    title: "ความเป็นส่วนตัวและความปลอดภัย (Talent Safety)",
    desc: "ขอความร่วมมือในการเคารพพื้นที่ส่วนตัวของทาเลนต์ ไม่สืบค้นหรือเผยแพร่ข้อมูลตัวตนจริง (IRL) และรักษาบรรยากาศการมีส่วนร่วมที่สุภาพ",
  },
  {
    title: "การจัดคิวงานและส่งมอบ (Studio Workflow)",
    desc: "งานสั่งทำสตูดิโอจะจัดคิวงานตามลำดับการชำระเงินมัดจำ และจะส่งมอบไฟล์งานสมบูรณ์เมื่อชำระครบเต็มจำนวนแล้วเท่านั้น",
  },
];
---

<Layout
  title="ช่องทางการติดต่อ - WINEST Official Contact"
  description="ศูนย์ข้อมูลและการติดต่อค่าย WINEST: ติดต่อค่ายสำหรับงานสปอนเซอร์และ Collab VTuber และช่องทางติดต่องานคอมมิชชันโมเดล Live2D กับสตูดิโอ"
>
  <Navbar />

  <main class="about-page-main">
    <div class="about-container">

      <!-- ============================================================
           HERO MASTHEAD: Concise Title & In-Page Anchors
           ============================================================ -->
      <header class="about-hero-section">
        <span class="about-hero-kicker">CONTACT DIRECTORY</span>
        <h1 class="about-hero-title">ช่องทางการติดต่อ</h1>

        <!-- Quick Navigation Anchors -->
        <nav class="about-nav-anchors" aria-label="หมวดหมู่หน้าติดต่อ">
          <a href="#agency-contact" class="about-anchor-pill">
            <Icon name="x-twitter" width="14" height="14" />
            <span>1. ติดต่อค่าย & ความร่วมมือ VTuber</span>
          </a>
          <a href="#hiring-contact" class="about-anchor-pill">
            <Icon name="grid" width="14" height="14" />
            <span>2. ติดต่องานคอมมิชชันสตูดิโอ</span>
          </a>
          <a href="#policies" class="about-anchor-pill">
            <Icon name="check" width="14" height="14" />
            <span>3. นโยบายค่าย</span>
          </a>
        </nav>
      </header>

      <div class="about-divider" aria-hidden="true"></div>

      <!-- ============================================================
           SECTION 1: ติดต่อค่าย (สปอนเซอร์, คอลแลป, งานเกี่ยวกับค่ายและ VTuber)
           ============================================================ -->
      <section class="about-zone" id="agency-contact">
        <div class="zone-header-block">
          <span class="zone-tag-kicker">PART 01 · AGENCY & VTUBER</span>
          <h2 class="zone-main-heading">1. ติดต่อค่าย และความร่วมมือ VTuber</h2>
          <p class="zone-subtext">
            สำหรับเสนอความร่วมมือทางธุรกิจ, งานสปอนเซอร์แบรนด์, งานอีเวนต์ หรือนัดหมายสตรีม Collab ร่วมกับทาเลนต์ VTuber ของค่าย
          </p>
        </div>

        <div class="zone-cards-grid-2">
          <!-- Channel 1: X (Twitter) -->
          <a
            href="https://x.com/Winest_vt"
            target="_blank"
            rel="noopener noreferrer"
            class="unified-card"
          >
            <div class="card-top-row">
              <div class="card-icon-frame" aria-hidden="true">
                <Icon name="x-twitter" width="22" height="22" />
              </div>
              <div class="card-title-group">
                <h3>X Direct Message</h3>
                <span class="card-sub-tag">@Winest_vt</span>
              </div>
            </div>
            <p class="card-body-text">
              ทัก DM ได้ทันทีสำหรับเสนองานสปอนเซอร์ คอลแลปด่วน หรือสอบถามข้อเสนอความร่วมมือเบื้องต้นกับทีมงานค่าย
            </p>
            <span class="card-action-row">
              <span>ทัก DM บน X (@Winest_vt)</span>
              <Icon name="arrow-diagonal" width="14" height="14" />
            </span>
          </a>

          <!-- Channel 2: Discord Community -->
          <a
            href="https://discord.gg"
            target="_blank"
            rel="noopener noreferrer"
            class="unified-card"
          >
            <div class="card-top-row">
              <div class="card-icon-frame" aria-hidden="true">
                <Icon name="discord" width="22" height="22" />
              </div>
              <div class="card-title-group">
                <h3>Discord Community</h3>
                <span class="card-sub-tag">WINEST Server</span>
              </div>
            </div>
            <p class="card-body-text">
              ส่งข้อความในห้อง <em>#collab-inquiries</em> เพื่อนัดหมายสตรีมร่วมกัน หรือประสานงานสำหรับครีเอเตอร์และพาร์ตเนอร์
            </p>
            <span class="card-action-row">
              <span>เข้าร่วม WINEST Discord</span>
              <Icon name="arrow-diagonal" width="14" height="14" />
            </span>
          </a>
        </div>
      </section>

      <div class="about-divider" aria-hidden="true"></div>

      <!-- ============================================================
           SECTION 2: ติดต่องานคอมมิชชัน (โมเดล Live2D, วาดคน, วาดฉากหลัง)
           ใช้อีกลิงก์ตามที่ผู้ใช้กำหนด (Kenelix Studio & /commissions)
           ============================================================ -->
      <section class="about-zone" id="hiring-contact">
        <div class="zone-header-block">
          <span class="zone-tag-kicker">PART 02 · CREATIVE STUDIO & COMMISSIONS</span>
          <h2 class="zone-main-heading">2. ติดต่องานคอมมิชชันสตูดิโอ (Kenelix Studio)</h2>
          <p class="zone-subtext">
            สำหรับครีเอเตอร์และบุคคลทั่วไปที่ต้องการสั่งจ้างงานโปรดักชัน: วาดและริกโมเดล VTuber Live2D, ออกแบบ Character Sheet หรือวาดฉากสตรีมมิ่ง 4K พร้อมสิทธิ์เชิงพาณิชย์
          </p>
        </div>

        <div class="zone-cards-grid-2">
          <!-- Option A: ดูรายละเอียดเรทราคา & ผลงานจริง -->
          <a
            href="/commissions"
            class="unified-card"
          >
            <div class="card-top-row">
              <div class="card-icon-frame" aria-hidden="true">
                <Icon name="grid" width="22" height="22" />
              </div>
              <div class="card-title-group">
                <h3>สำรวจเรทราคา & ผลงานจริง</h3>
                <span class="card-sub-tag">Commissions Portfolio & Rates</span>
              </div>
            </div>
            <p class="card-body-text">
              เข้าชมหน้ารวมงานคอมมิชชันเพื่อดูสเปกโมเดล Live2D ทุกระดับ (Tier 1–3), คลิปวิดีโอตัวอย่างการเคลื่อนไหวจริง และภาพผลงานโมเดลทั้ง 6 รายการ
            </p>
            <span class="card-solid-btn">
              <span>ดูข้อมูลคอมมิชชันทั้งหมด</span>
              <Icon name="arrow-right" width="15" height="15" />
            </span>
          </a>

          <!-- Option B: เปิด Ticket สั่งจ้างงานสตูดิโอ (ใช้อีกลิงก์) -->
          <a
            href={atelier.discordUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="unified-card"
          >
            <div class="card-top-row">
              <div class="card-icon-frame" aria-hidden="true">
                <Icon name="discord" width="22" height="22" />
              </div>
              <div class="card-title-group">
                <h3>เปิด Ticket สั่งจ้างงาน (Kenelix Studio)</h3>
                <span class="card-sub-tag">Direct Studio Inquiry</span>
              </div>
            </div>
            <p class="card-body-text">
              เปิด Ticket ส่งไฟล์บรีฟ ปรึกษาคิวงาน หรือขอใบเสนอราคาสำหรับการสั่งทำโมเดลและงานวาดกับทีมสตูดิโอ Kenelix Studio โดยตรง
            </p>
            <span class="card-outline-btn">
              <Icon name="discord" width="16" height="16" />
              <span>เปิด Ticket จ้างงานสตูดิโอ ↗</span>
            </span>
          </a>
        </div>
      </section>

      <div class="about-divider" aria-hidden="true"></div>

      <!-- ============================================================
           SECTION 3: นโยบายและแนวทางปฏิบัติเบื้องต้น
           ============================================================ -->
      <section class="about-zone" id="policies">
        <div class="zone-header-block">
          <span class="zone-tag-kicker">PART 03 · GUIDELINES & POLICIES</span>
          <h2 class="zone-main-heading">3. นโยบายของค่าย และข้อตกลง</h2>
          <p class="zone-subtext">
            แนวทางปฏิบัติเบื้องต้นสำหรับการสนับสนุนทาเลนต์และการประสานงานกับสตูดิโอ
          </p>
        </div>

        <div class="zone-cards-grid-3">
          {guidelines.map((g) => (
            <article class="unified-card">
              <h3 class="policy-card-title">{g.title}</h3>
              <p class="policy-body-text">{g.desc}</p>
            </article>
          ))}
        </div>
      </section>

    </div>
  </main>

  <Footer />

  <script>
    // Smooth scrolling for in-page anchors
    document.querySelectorAll('.about-anchor-pill[href^="#"]').forEach((anchor) => {
      anchor.addEventListener('click', (e) => {
        const targetId = anchor.getAttribute('href');
        if (!targetId || targetId === '#') return;
        const targetEl = document.querySelector(targetId);
        if (targetEl) {
          e.preventDefault();
          targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  </script>
</Layout>
