---
// src/pages/about.astro - WINEST Official Contact, Services & Policies
// 3 หมวดหมู่หลัก: 1. ติดต่อค่าย & VTuber | 2. ติดต่อจ้างงาน (3 บริการ) | 3. นโยบายค่าย
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/common/Icon.astro";
import "../styles/global.css";
import "../styles/scroll-reveal.css";
import "../styles/about-page.css";

// 3 บริการหลักของค่าย WINEST (กระชับ ชัดเจน กวาดตาอ่านได้ทันที)
const studioServices = [
  {
    title: "บริการวาดรูปครบวงจร",
    subTitle: "Character Design · วาดคน · วาดฉาก",
    bullets: [
      "ออกแบบคาแรกเตอร์ดีไซน์ (3 มุมมอง)",
      "วาดคน ภาพประกอบตัวละคร และงานโปรโมต",
      "วาดฉากหลังสตรีมมิ่ง 4K (2D / 2.5D)",
    ],
    accent: "#e098a1",
  },
  {
    title: "บริการริกโมเดล",
    subTitle: "Live2D Model Rigging",
    bullets: [
      "ระบบฟิสิกส์เส้นผมและเสื้อผ้าพริ้วไหว",
      "การเคลื่อนไหวศีรษะและลำตัว XYZ",
      "เซ็ตอัปการแสดงอารมณ์ทางใบหน้าครบชุด",
    ],
    accent: "#8b5cf6",
  },
  {
    title: "บริการมิกซ์เพลง",
    subTitle: "Audio Mixing & Mastering",
    bullets: [
      "จูนเสียงร้องและจัดจังหวะระดับโปร",
      "มิกซ์บาลานซ์ดนตรีและมิติเสียงสมบูรณ์",
      "มาสเตอริ่งพร้อมเผยแพร่ทุกสตรีมมิ่ง",
    ],
    accent: "#06b6d4",
  },
];

// นโยบายของค่าย (สรุปเฉพาะประเด็นสำคัญ กระชับ ไม่เวิ่นเว้อ)
const policies = [
  {
    id: "fanart",
    title: "ผลงานแฟนอาร์ต (Fan Art)",
    desc: "สร้างสรรค์และเผยแพร่ผลงานเพื่อสนับสนุนทาเลนต์ได้อิสระ โดยไม่อนุญาตให้นำไปใช้ในเชิงพาณิชย์",
    tag: "Fan Work",
  },
  {
    id: "commercial",
    title: "การว่าจ้างและลิขสิทธิ์ (Commercial Terms)",
    desc: "งานวาด ริกโมเดล และมิกซ์เพลง ได้รับสิทธิ์การใช้งานเชิงพาณิชย์เต็มรูปแบบตามขอบเขตงาน",
    tag: "Commercial Ready",
  },
  {
    id: "safety",
    title: "ความปลอดภัยและชุมชน (Safety & Privacy)",
    desc: "เคารพความเป็นส่วนตัวของทาเลนต์และเพื่อนร่วมคอมมิวนิตี้ ห้ามคุกคามหรือเผยแพร่ข้อมูลตัวตนจริง",
    tag: "Community First",
  },
];
---

<Layout
  title="WINEST - ติดต่อค่าย ติดต่องาน และนโยบาย"
  description="ศูนย์ข้อมูลและการติดต่อ WINEST: ประสานงาน VTuber, บริการจ้างงานสตูดิโอ (วาดรูปครบวงจร, ริกโมเดล, มิกซ์เพลง) และนโยบายค่าย"
>
  <Navbar />

  <main class="about-page-main">
    <!-- ===================================================================
         HERO MASTHEAD & QUICK NAVIGATION
         =================================================================== -->
    <header class="about-hero-section">
      <h1 class="about-hero-title">ศูนย์ข้อมูลและการติดต่อ</h1>
      <p class="about-hero-desc">
        ช่องทางติดต่อค่าย ทาเลนต์ บริการจ้างงานโปรดักชัน และนโยบายทางการ
      </p>

      <!-- Quick Navigation Anchors -->
      <nav class="about-nav-anchors" aria-label="หมวดหมู่หน้าติดต่อ">
        <a href="#agency-contact" class="about-anchor-pill">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            ><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle
              cx="9"
              cy="7"
              r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path
              d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg
          >
          <span>ติดต่อค่าย & ทาเลนต์</span>
        </a>
        <a href="#hiring-contact" class="about-anchor-pill">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            ><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path
              d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg
          >
          <span>บริการจ้างงานสตูดิโอ</span>
        </a>
        <a href="#policies" class="about-anchor-pill">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            ><path
              d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
            ></path><polyline points="14 2 14 8 20 8"></polyline><line
              x1="16"
              y1="13"
              x2="8"
              y2="13"></line><line x1="16" y1="17" x2="8" y2="17"
            ></line><polyline points="10 9 9 9 8 9"></polyline></svg
          >
          <span>นโยบายค่าย</span>
        </a>
      </nav>
    </header>

    <!-- ===================================================================
         ส่วนที่ 1: ติดต่อค่ายและความร่วมมือ VTUBER
         (Collab, Sponsor, Event, Media)
         =================================================================== -->
    <section class="about-zone" id="agency-contact">
      <div class="zone-header-block">
        <h2 class="zone-main-heading">ติดต่อค่าย และความร่วมมือ VTuber</h2>
        <p class="zone-subtext">
          สำหรับเสนอ Collab สตรีมเกม/เพลง, งานสปอนเซอร์แบรนด์, อีเวนต์
          หรือติดต่องานกับทาเลนต์
        </p>
      </div>

      <!-- Fast-Track Contact Lanes (Editorial Split-Lane with Vertical Divider, No Box Cards) -->
      <div class="fast-track-lanes">
        <!-- Lane 1: X Direct Message -->
        <a
          href="https://x.com/Winest_vt"
          target="_blank"
          rel="noopener noreferrer"
          class="contact-lane-item is-x"
        >
          <div class="lane-identity">
            <div class="lane-icon-frame is-x" aria-hidden="true">
              <Icon name="x-twitter" width="22" height="22" />
            </div>
            <div class="lane-title-group">
              <h3 class="lane-headline">X Direct Message</h3>
              <span class="lane-handle">@Winest_vt</span>
            </div>
          </div>

          <p class="lane-description">
            ทัก DM ได้ทันทีสำหรับเสนอ Collab ด่วน ชวนสตรีมเกม หรือสอบถามข้อเสนอเบื้องต้นกับทีมงาน
          </p>

          <div class="lane-action-link">
            <span>ทัก DM บน X</span>
            <Icon name="arrow-diagonal" width="14" height="14" />
          </div>
        </a>

        <!-- Central Vertical Divider -->
        <div class="lane-vertical-divider" aria-hidden="true"></div>

        <!-- Lane 2: Discord Community -->
        <a
          href="https://discord.gg"
          target="_blank"
          rel="noopener noreferrer"
          class="contact-lane-item is-discord"
        >
          <div class="lane-identity">
            <div class="lane-icon-frame is-discord" aria-hidden="true">
              <Icon name="discord" width="22" height="22" />
            </div>
            <div class="lane-title-group">
              <h3 class="lane-headline">Discord Community</h3>
              <span class="lane-handle">WINEST Server</span>
            </div>
          </div>

          <p class="lane-description">
            ส่งข้อความในห้อง <em>#collab-inquiries</em> เพื่อนัดหมายสตรีมร่วมกัน หรือพูดคุยแลกเปลี่ยนกับครีเอเตอร์
          </p>

          <div class="lane-action-link">
            <span>เข้าร่วม Discord</span>
            <Icon name="arrow-diagonal" width="14" height="14" />
          </div>
        </a>
      </div>
    </section>

    <!-- Section Spacer -->
    <div class="zone-spacer" aria-hidden="true"></div>

    <!-- ===================================================================
         ส่วนที่ 2: บริการจ้างงานสตูดิโอ (CREATIVE STUDIO SERVICES)
         (3 บริการหลัก: วาดรูปครบวงจร, ริกโมเดล, มิกซ์เพลง)
         =================================================================== -->
    <section class="about-zone" id="hiring-contact">
      <div class="zone-header-block">
        <h2 class="zone-main-heading">บริการจ้างงานสตูดิโอ</h2>
        <p class="zone-subtext">
          สตูดิโอ WINEST ให้บริการโปรดักชันระดับพรีเมียมสำหรับ VTuber
          และครีเอเตอร์ พร้อมสิทธิ์เชิงพาณิชย์ครบวงจร
        </p>
      </div>

      <!-- 3 Service Cards Grid -->
      <div class="services-three-grid">
        {
          studioServices.map((srv) => (
            <div
              class="service-three-card"
              style={`--service-accent: ${srv.accent};`}
            >
              <div>
                <h3 class="service-three-title">{srv.title}</h3>
                <div class="service-three-subtitle">{srv.subTitle}</div>
                <ul class="service-three-bullets">
                  {srv.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Action Banner -->
      <div class="commercial-contact-banner">
        <div class="banner-left-info">
          <h3 class="banner-headline">สนใจจ้างงาน หรือขอใบเสนอราคา?</h3>
          <p class="banner-desc">
            เปิด Ticket ใน Discord หรือทัก DM บน X
            เพื่อเช็กคิวงานและประเมินราคาได้ทันที
          </p>
        </div>
        <div class="banner-actions-wrap">
          <a
            href="https://discord.gg"
            target="_blank"
            rel="noopener noreferrer"
            class="discord-ticket-btn"
          >
            <Icon name="discord" width="16" height="16" />
            <span>เปิด Ticket ใน Discord</span>
          </a>
          <a
            href="https://x.com/Winest_vt"
            target="_blank"
            rel="noopener noreferrer"
            class="x-dm-btn"
          >
            <Icon name="x-twitter" width="16" height="16" />
            <span>ทัก DM บน X</span>
          </a>
          <button
            type="button"
            class="copy-email-btn"
            id="copyEmailBtn"
            data-email="contact@winest.studio"
            title="สำหรับส่งอีเมลสำรอง"
          >
            <Icon name="mail" width="14" height="14" />
            <span id="copyBtnText">คัดลอกอีเมล</span>
          </button>
        </div>
      </div>
    </section>

    <!-- Section Spacer -->
    <div class="zone-spacer" aria-hidden="true"></div>

    <!-- ===================================================================
         ส่วนที่ 3: นโยบายของค่าย (POLICIES & GUIDELINES)
         (สรุปสาระสำคัญ สั้น กระชับ)
         =================================================================== -->
    <section class="about-zone" id="policies">
      <div class="zone-header-block">
        <h2 class="zone-main-heading">นโยบายของค่าย</h2>
        <p class="zone-subtext">
          แนวทางปฏิบัติและข้อกำหนดเบื้องต้น (เอกสารฉบับสมบูรณ์อยู่ระหว่างจัดทำ)
        </p>
      </div>

      <!-- 3 Compact Policy Cards -->
      <div class="policy-card-grid">
        {
          policies.map((p) => (
            <div class="policy-card" id={`policy-${p.id}`}>
              <span class="policy-badge">{p.tag}</span>
              <h3 class="policy-card-title">{p.title}</h3>
              <p class="policy-lorem-text" style="margin: 0;">
                {p.desc}
              </p>
            </div>
          ))
        }
      </div>
    </section>
  </main>

  <Footer />

  <!-- Interactive Copy Email Script -->
  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const copyBtn = document.getElementById("copyEmailBtn");
      const copyText = document.getElementById("copyBtnText");
      if (copyBtn && copyText) {
        copyBtn.addEventListener("click", async () => {
          const email =
            copyBtn.getAttribute("data-email") || "contact@winest.studio";
          try {
            await navigator.clipboard.writeText(email);
            copyText.textContent = "คัดลอกแล้ว! ✓";
            setTimeout(() => {
              copyText.textContent = "คัดลอกอีเมล";
            }, 3000);
          } catch (err) {
            window.location.href = `mailto:${email}`;
          }
        });
      }
    });
  </script>
</Layout>
