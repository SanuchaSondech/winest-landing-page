---
// index.astro - WINEST Official Wonderland Landing Page (Route: /)
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import HeroVideo from "../components/HeroVideo.astro";
import AboutBrief from "../components/AboutBrief.astro";
import ArtsSection from "../components/ArtsSection.astro";
import MembersSection from "../components/MembersSection.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<Layout
  title="WINEST - ค่าย VTuber และบริการงานวาดครบวงจร"
  description="ยินดีต้อนรับสู่ WINEST ค่าย VTuber และสตูดิโอรับออกแบบ Character Sheet, Live2D, สติกเกอร์ LINE และฉากสตรีมมิ่งระดับพรีเมียม"
>
  <!-- Main Navigation Bar -->
  <Navbar />

  <!-- Main Content Areas -->
  <main id="main-content">
    <!-- ส่วน 1 : พื้นที่สำหรับคลิป 16:9 ธีมโรงละครสวนสนุก -->
    <HeroVideo />

    <!-- ส่วน 2 : พื้นที่สำหรับข้อมูลคร่าว ๆ ว่าเป็นค่ายเกี่ยวกับอะไร -->
    <AboutBrief />

    <!-- ส่วน 3 : พื้นที่สำหรับโปรโมท V (คลิกแล้วพาไป /members) -->
    <MembersSection />

    <!-- ส่วน 4 : พื้นที่สำหรับแสดงงานวาด (คลิกแล้วพาไป /arts) -->
    <ArtsSection />
  </main>

  <!-- ส่วนล่าง : ช่องทางติดต่อค่าย และลิงก์ไป /about -->
  <Footer />
</Layout>
