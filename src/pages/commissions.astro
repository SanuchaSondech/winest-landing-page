---
// src/pages/commissions.astro - World-Class Editorial Commissions Showcase
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import commissionsData from '../data/commissions.json';
import '../styles/global.css';
import '../styles/commissions.css';

const { atelier, models, terms, showcases } = commissionsData;
---

<Layout 
  title="WINEST x KENELIX STUDIO - Live2D Model Commissions"
  description="บริการออกแบบ วาดชิ้นส่วนแยกเลเยอร์ และริกโมเดล Live2D ครบวงจรสำหรับ VTuber และครีเอเตอร์ เปรียบเทียบสเปก 3 แพ็กเกจ เรทราคา และเงื่อนไขการผ่อนชำระ"
>
  <Navbar />

  <main class="commissions-main" id="commissions-main">
    <div class="container">

      <!-- ============================================================
           1. Editorial Masthead
           ============================================================ -->
      <header class="commissions-masthead">
        <div class="masthead-meta">{atelier.collaboration}</div>
        <h1 class="masthead-title">{atelier.title}</h1>
        <p class="masthead-lead">{atelier.lead}</p>

        <div class="masthead-action-row">
          <a href="#models-matrix" class="editorial-text-link">
            <span>เปรียบเทียบสเปกแพ็กเกจ</span>
            <span aria-hidden="true">↓</span>
          </a>
          <a href="#pricing-breakdown" class="editorial-text-link">
            <span>เรทราคาทุกระดับ (Tier)</span>
            <span aria-hidden="true">↓</span>
          </a>
          <a href="#studio-terms" class="editorial-text-link">
            <span>การผ่อนและนโยบาย</span>
            <span aria-hidden="true">↓</span>
          </a>
          <a href={atelier.discordUrl} target="_blank" rel="noopener noreferrer" class="editorial-text-link primary">
            <span>ติดต่อสั่งทำผ่าน Discord</span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </header>

      <!-- ============================================================
           2. Master Model Comparison (Apple-Style Spec Columns)
           ============================================================ -->
      <section class="models-matrix-section" id="models-matrix">
        <span class="section-label">Model Architecture</span>
        <h2 class="section-heading">เปรียบเทียบโครงสร้างและสเปกโมเดล</h2>

        <div class="models-spec-grid">
          {models.map((model) => (
            <div class="model-spec-col">
              <div class="model-col-header">
                <h3 class="model-col-name">{model.name}</h3>
                <div class="model-col-sub">{model.subtitle}</div>
                <p style="font-size: 0.8125rem; color: var(--text-secondary); line-height: 1.5; margin: 0;">
                  {model.summary}
                </p>

                <div class="model-price-lockup">
                  <span class="price-caption">Combo Set เริ่มต้น</span>
                  <div class="price-figure">
                    <span>฿{model.startingPrice.toLocaleString()}</span>
                    <span class="price-unit">THB</span>
                  </div>
                  <div class="price-discount-note">ประหยัดพิเศษ {model.discount}</div>
                </div>
              </div>

              <!-- Spec Rows -->
              <div class="model-spec-list">
                <div class="model-spec-item">
                  <span class="spec-key">ขอบเขตสัดส่วน</span>
                  <span class="spec-val">{model.specs.scope}</span>
                </div>
                <div class="model-spec-item">
                  <span class="spec-key">โครงสร้างภายใน</span>
                  <span class="spec-val">{model.specs.interiorBody}</span>
                </div>
                <div class="model-spec-item">
                  <span class="spec-key">ระบบเสื้อผ้า & ชุดเสริม</span>
                  <span class="spec-val">{model.specs.outfitSystem}</span>
                </div>
                <div class="model-spec-item">
                  <span class="spec-key">ของแถมในแพ็กเกจ</span>
                  <span class="spec-val" style="color: var(--accent-primary); font-weight: 600;">{model.specs.included}</span>
                </div>
              </div>

              <a 
                href={atelier.discordUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="editorial-text-link primary" 
                style="margin-top: auto; padding-top: 16px;"
              >
                <span>ปรึกษาบรีฟ {model.name} ↗</span>
              </a>
            </div>
          ))}
        </div>
      </section>

      <!-- ============================================================
           3. Comprehensive Pricing Breakdown Tables
           ============================================================ -->
      <section class="pricing-tables-wrapper" id="pricing-breakdown">
        <span class="section-label">Price Catalog</span>
        <h2 class="section-heading">เรทราคาและส่วนเสริม Accessory</h2>

        <!-- Tier Pricing Breakdown Table -->
        <h3 class="data-section-title">เรทราคาวาดและริกโมเดลแยกตามระดับ (Tier 1 – 3)</h3>
        <table class="editorial-data-table">
          <thead>
            <tr>
              <th>แพ็กเกจ</th>
              <th>ระดับ (Tier)</th>
              <th>เฉพาะวาด (Draw)</th>
              <th>เฉพาะริก (Rig)</th>
              <th>โปร วาด & ริก (Combo)</th>
            </tr>
          </thead>
          <tbody>
            {models.flatMap((m) =>
              m.tiers.map((t, idx) => (
                <tr>
                  <td>{idx === 0 ? <strong>{m.name} ({m.subtitle})</strong> : ''}</td>
                  <td>{t.name}</td>
                  <td class="cell-num">฿{t.draw.toLocaleString()}</td>
                  <td class="cell-num">฿{t.rig.toLocaleString()}</td>
                  <td class="cell-num highlight">฿{t.combo.toLocaleString()}</td>
                </tr>
              ))
            )}
          </tbody>
        </table>

        <!-- Accessory Pricing Table -->
        <h3 class="data-section-title">ส่วนเสริม Accessory (ACC) แยกตามขนาดโมเดล</h3>
        <table class="editorial-data-table">
          <thead>
            <tr>
              <th>หมวดส่วนเสริม</th>
              <th>Half Body (Tier 1)</th>
              <th>Simple Full (Tier 2)</th>
              <th>Full Body (Tier 3)</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>ทรงผม / ศีรษะ</strong></td>
              <td class="cell-num">฿125 <span style="font-size: 0.75rem; color: var(--text-secondary);">(วาด 65 / ริก 60)</span></td>
              <td class="cell-num">฿240 <span style="font-size: 0.75rem; color: var(--text-secondary);">(วาด 140 / ริก 180)</span></td>
              <td class="cell-num">฿385 <span style="font-size: 0.75rem; color: var(--text-secondary);">(วาด 260 / ริก 290)</span></td>
            </tr>
            <tr>
              <td><strong>เสื้อผ้า / เครื่องแต่งกาย</strong></td>
              <td class="cell-num">฿640 <span style="font-size: 0.75rem; color: var(--text-secondary);">(วาด 450 / ริก 350)</span></td>
              <td class="cell-num">฿1,100 <span style="font-size: 0.75rem; color: var(--text-secondary);">(วาด 750 / ริก 730)</span></td>
              <td class="cell-num">฿1,610 <span style="font-size: 0.75rem; color: var(--text-secondary);">(วาด 1,150 / ริก 1,150)</span></td>
            </tr>
            <tr>
              <td><strong>ตัวละครจิบิ (Chibi)</strong></td>
              <td class="cell-num">฿2,200 <span style="font-size: 0.75rem; color: var(--text-secondary);">(วาด 1,200 / ริก 1,500)</span></td>
              <td class="cell-num">฿2,910 <span style="font-size: 0.75rem; color: var(--text-secondary);">(วาด 2,180 / ริก 1,700)</span></td>
              <td class="cell-num">฿3,710 <span style="font-size: 0.75rem; color: var(--text-secondary);">(วาด 2,900 / ริก 2,400)</span></td>
            </tr>
            <tr>
              <td><strong>พร็อพ / อาวุธ / อื่นๆ</strong></td>
              <td colspan="3" style="color: var(--text-secondary);">ประเมินราคาตามรายละเอียดและความซับซ้อนของชิ้นงาน</td>
            </tr>
          </tbody>
        </table>
      </section>

      <!-- ============================================================
           4. Terms, Timeline & Installment (Editorial 3-Col Split)
           ============================================================ -->
      <section class="terms-split-section" id="studio-terms">
        <span class="section-label">Commercial Guidelines</span>
        <h2 class="section-heading">ระยะเวลา การผ่อนชำระ และนโยบายสตูดิโอ</h2>

        <div class="terms-3col-layout">
          {terms.map((col) => (
            <div class="terms-col">
              <div class="terms-col-head">
                <h3 class="terms-col-title">{col.title}</h3>
                <div class="terms-col-sub">{col.subtitle}</div>
              </div>

              <div class="terms-kv-list">
                {col.items.map((item) => (
                  <div class="terms-kv-item">
                    <span class="terms-k">{item.label}</span>
                    <span class="terms-v">{item.value}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- ============================================================
           5. Official Models Showcase (Pristine Art Duet)
           ============================================================ -->
      <section class="showcase-duet-section">
        <span class="section-label">Selected Works</span>
        <h2 class="section-heading">โมเดลทาเลนต์ประจำค่าย WINEST</h2>

        <div class="showcase-duet-grid">
          {showcases.map((talent) => (
            <article class="showcase-talent-frame">
              <div class="showcase-talent-art">
                <img src={talent.image} alt={talent.name} loading="lazy" decoding="async" />
              </div>
              <div class="talent-caption-bar">
                <div>
                  <h3>{talent.name}</h3>
                  <div style="font-size: 0.8125rem; color: var(--text-secondary);">{talent.artist}</div>
                </div>
                <span class="talent-spec-meta">{talent.title}</span>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- ============================================================
           6. Minimal Closing Action
           ============================================================ -->
      <section class="closing-action-section">
        <h2 class="closing-title">พร้อมเริ่มต้นโปรดักชันโมเดลของคุณ?</h2>
        <p class="closing-desc">
          พูดคุยสอบถามรายละเอียด ประเมินคิวงาน หรือส่งไฟล์บรีฟตัวละครกับทีมงาน Kenelix Studio โดยตรง
        </p>
        <a href={atelier.discordUrl} target="_blank" rel="noopener noreferrer" class="closing-btn">
          <span>ติดต่อผ่าน Discord (Kenelix Studio)</span>
          <span aria-hidden="true">↗</span>
        </a>
      </section>

    </div>
  </main>

  <Footer />
</Layout>
