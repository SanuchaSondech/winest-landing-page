---
// src/pages/commissions.astro - World-Class Three-Pillar Creative Studio Showcase
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/common/Icon.astro';
import commissionsData from '../data/commissions.json';
import '../styles/global.css';
import '../styles/commissions.css';

const { 
  atelier, 
  tierLegend,
  recommendedPackages, 
  tierPricing, 
  accessories, 
  illustrations, 
  audioMixing, 
  terms 
} = commissionsData;
---

<Layout 
  title="WINEST x KENELIX STUDIO - Creative Studio & Commissions"
  description="บริการสร้างสรรค์งานโปรดักชันครบวงจร: โมเดล Live2D, วาดภาพประกอบและฉากสตรีมมิ่ง 4K, และบริการมิกซ์เพลงคุณภาพสูง"
>
  <Navbar />

  <main class="commissions-main" id="commissions-main">
    <div class="container">

      <!-- ============================================================
           HEADER: Editorial Masthead
           ============================================================ -->
      <header class="commissions-masthead">
        <div class="masthead-meta">{atelier.collaboration}</div>
        <h1 class="masthead-title">{atelier.title}</h1>
        <p class="masthead-lead">{atelier.lead}</p>

        <div class="masthead-action-row">
          <a href="#models-section" class="editorial-text-link">
            <span>1. โมเดล Live2D</span>
            <span aria-hidden="true">↓</span>
          </a>
          <a href="#illustration-section" class="editorial-text-link">
            <span>2. งานวาด & ฉากหลัง</span>
            <span aria-hidden="true">↓</span>
          </a>
          <a href="#audio-section" class="editorial-text-link">
            <span>3. งานเสียง & มิกซ์เพลง</span>
            <span aria-hidden="true">↓</span>
          </a>
          <a href="#studio-terms" class="editorial-text-link">
            <span>เงื่อนไข & การผ่อน</span>
            <span aria-hidden="true">↓</span>
          </a>
          <a href={atelier.discordUrl} target="_blank" rel="noopener noreferrer" class="editorial-text-link primary">
            <span>ติดต่อ Discord</span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </header>

      <!-- ============================================================
           PART 1: โมเดล Live2D (Live2D Model Commissions)
           ============================================================ -->
      <section class="recommended-section" id="models-section">
        <span class="section-label">Pillar 01 · Live2D Models</span>
        <h2 class="section-heading has-desc">โมเดล Live2D (แพ็กเกจแนะนำ)</h2>
        <p class="section-desc">แพ็กเกจคอมโบงานวาดแยกชิ้นส่วนและริกเกลี่ยการเคลื่อนไหวครบวงจร พร้อมไฟล์ติดตั้งใช้งานได้ทันที</p>

        <div class="recommended-cards-grid">
          {recommendedPackages.map((pkg) => (
            <article class="package-card">
              <div class="pkg-header">
                <div class="pkg-identity">
                  <h3 class="pkg-title">{pkg.name}</h3>
                  <span class="pkg-tag">{pkg.subtitle}</span>
                </div>

                <div class="pkg-price-row">
                  <span class="price-lead">เริ่มต้น</span>
                  <span class="price-num">฿{pkg.startingPrice.toLocaleString()}</span>
                  <span class="price-save">({pkg.discount})</span>
                </div>
              </div>

              <!-- 3 Clean Bullets -->
              <ul class="pkg-bullets">
                {pkg.bullets.map((bullet, bIdx) => (
                  <li class="pkg-bullet-item">
                    <Icon name={bIdx === 2 ? 'avatar-star' : 'check'} width="13" height="13" class="pkg-bullet-svg" />
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>

              <!-- Action Button -->
              <a 
                href={atelier.discordUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="pkg-cta"
              >
                <span>สั่งทำ {pkg.name}</span>
                <span aria-hidden="true">↗</span>
              </a>
            </article>
          ))}
        </div>
      </section>

      <!-- Complete Price Comparison Matrix (Tiers & Accessories) -->
      <section class="pricing-matrix-section" id="pricing-matrix">
        <span class="section-label">Full Price Catalog</span>
        <h2 class="section-heading has-desc">ตารางเปรียบเทียบราคาโมเดลทั้งหมด</h2>
        <p class="section-desc">รายละเอียดเรทราคาแยกตามระดับความละเอียดของการเคลื่อนไหว และชิ้นส่วนเสริม</p>

        <!-- Tier Guide Bar (Clears all doubts about Tier 1, 2, 3) -->
        <div class="tier-legend-strip">
          {tierLegend && tierLegend.map((tl) => (
            <div class="tier-legend-item">
              <span class="tier-legend-badge">{tl.tier} · {tl.name}</span>
              <span class="tier-legend-text">{tl.summary}</span>
            </div>
          ))}
        </div>

        <!-- Tier 1-3 Table -->
        <h3 class="table-subheading">เรทราคาวาดและริกโมเดลแยกตามระดับ (Tier 1 – 3)</h3>
        <div class="table-scroll-wrapper">
          <table class="comparison-table">
            <thead>
              <tr>
                <th>แพ็กเกจโมเดล</th>
                <th>ระดับ (Tier)</th>
                <th>เฉพาะวาด (Draw)</th>
                <th>เฉพาะริก (Rig)</th>
                <th>โปร วาด & ริก (Combo Set)</th>
              </tr>
            </thead>
            <tbody>
              {tierPricing.flatMap((group) =>
                group.tiers.map((t, tIdx) => (
                  <tr class={tIdx === 0 ? 'group-start' : ''}>
                    <td class="pkg-cell">{tIdx === 0 ? group.package : ''}</td>
                    <td>{t.tier}</td>
                    <td class="num-cell">฿{t.draw.toLocaleString()}</td>
                    <td class="num-cell">฿{t.rig.toLocaleString()}</td>
                    <td class="combo-cell">฿{t.combo.toLocaleString()}</td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>

        <!-- Accessory Table -->
        <h3 class="table-subheading">ส่วนเสริม Accessory (ACC) แยกตามขนาดโมเดล</h3>
        <div class="table-scroll-wrapper">
          <table class="comparison-table">
            <thead>
              <tr>
                <th>รายการส่วนเสริม</th>
                <th>Half Body (Tier 1)</th>
                <th>Simple Full (Tier 2)</th>
                <th>Full Body (Tier 3)</th>
              </tr>
            </thead>
            <tbody>
              {accessories.map((acc) => (
                <tr>
                  <td><strong>{acc.category}</strong></td>
                  {acc.customNote ? (
                    <td colspan="3" style="color: var(--text-secondary);">{acc.customNote}</td>
                  ) : (
                    <>
                      <td class="num-cell">฿{acc.half?.combo.toLocaleString()} <span style="font-size: 0.75rem; color: var(--text-secondary);">(วาด {acc.half?.draw} / ริก {acc.half?.rig})</span></td>
                      <td class="num-cell">฿{acc.simple?.combo.toLocaleString()} <span style="font-size: 0.75rem; color: var(--text-secondary);">(วาด {acc.simple?.draw} / ริก {acc.simple?.rig})</span></td>
                      <td class="combo-cell">฿{acc.full?.combo.toLocaleString()} <span style="font-size: 0.75rem; color: var(--text-secondary);">(วาด {acc.full?.draw} / ริก {acc.full?.rig})</span></td>
                    </>
                  )}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- ============================================================
           PART 2: บริการงานวาด & ฉากหลัง (Illustration & Backgrounds)
           ============================================================ -->
      <section class="recommended-section" id="illustration-section">
        <span class="section-label">Pillar 02 · Creative Illustration</span>
        <h2 class="section-heading has-desc">{illustrations.title}</h2>
        <p class="section-desc">{illustrations.lead}</p>

        <div class="recommended-cards-grid">
          {illustrations.items.map((item) => (
            <article class="package-card">
              <div class="pkg-header">
                <div class="pkg-identity">
                  <h3 class="pkg-title">{item.title}</h3>
                  <span class="pkg-tag">{item.badge}</span>
                </div>

                <div class="pkg-price-row">
                  <span class="price-num" style="font-size: 1.25rem;">{item.rate}</span>
                  <span class="price-lead" style="font-size: 0.75rem;">({item.rateSub})</span>
                </div>
              </div>

              <!-- 3 Clean Bullets -->
              <ul class="pkg-bullets">
                {item.bullets.map((bullet) => (
                  <li class="pkg-bullet-item">
                    <Icon name="check" width="13" height="13" class="pkg-bullet-svg" />
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>

              <!-- Action Button -->
              <a 
                href={atelier.discordUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="pkg-cta"
              >
                <span>ส่งบรีฟงานวาด ↗</span>
              </a>
            </article>
          ))}
        </div>
      </section>

      <!-- ============================================================
           PART 3: บริการงานเสียง & มิกซ์เพลง (Audio Mixing & Sound)
           ============================================================ -->
      <section class="recommended-section" id="audio-section">
        <span class="section-label">Pillar 03 · Audio & Sound Studio</span>
        <h2 class="section-heading has-desc">{audioMixing.title}</h2>
        <p class="section-desc">{audioMixing.lead}</p>

        <div class="recommended-cards-grid">
          {audioMixing.items.map((item) => (
            <article class="package-card">
              <div class="pkg-header">
                <div class="pkg-identity">
                  <h3 class="pkg-title">{item.title}</h3>
                  <span class="pkg-tag">{item.badge}</span>
                </div>

                <div class="pkg-price-row">
                  <span class="price-num" style="font-size: 1.25rem;">{item.rate}</span>
                  <span class="price-lead" style="font-size: 0.75rem;">({item.rateSub})</span>
                </div>
              </div>

              <!-- 3 Clean Bullets -->
              <ul class="pkg-bullets">
                {item.bullets.map((bullet) => (
                  <li class="pkg-bullet-item">
                    <Icon name="check" width="13" height="13" class="pkg-bullet-svg" />
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>

              <!-- Action Button -->
              <a 
                href={atelier.discordUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="pkg-cta"
              >
                <span>ส่งบรีฟงานเสียง ↗</span>
              </a>
            </article>
          ))}
        </div>
      </section>

      <!-- ============================================================
           PART 4: Terms, Timeline & Installment (Editorial 3-Col Split)
           ============================================================ -->
      <section class="terms-split-section" id="studio-terms">
        <span class="section-label">Commercial Guidelines</span>
        <h2 class="section-heading">ระยะเวลา การผ่อนชำระ และนโยบาย</h2>

        <div class="terms-3col-layout">
          {terms.map((col) => (
            <div class="terms-col">
              <h3 class="terms-col-title">{col.title}</h3>
              <ul class="terms-list">
                {col.points.map((pt) => (
                  <li class="terms-item">
                    <Icon name="check" width="12" height="12" class="terms-svg" />
                    <span>{pt}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- ============================================================
           PART 5: Minimal Closing Action
           ============================================================ -->
      <section class="closing-action-section">
        <h2 class="closing-title">พร้อมเริ่มต้นโปรดักชันของคุณ?</h2>
        <p class="closing-desc">
          ปรึกษาประเมินคิวงาน หรือส่งไฟล์บรีฟสำหรับงานโมเดล งานวาด และมิกซ์เพลงกับทีมงาน Kenelix Studio โดยตรง
        </p>
        <a href={atelier.discordUrl} target="_blank" rel="noopener noreferrer" class="closing-btn">
          <span>ติดต่อผ่าน Discord (Kenelix Studio)</span>
          <span aria-hidden="true">↗</span>
        </a>
      </section>

    </div>
  </main>

  <Footer />
</Layout>
