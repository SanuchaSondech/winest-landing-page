---
// src/pages/commissions.astro - World-Class Creative Studio Showcase & Commissions
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/common/Icon.astro';
import ModelZoomModal from '../components/commissions/ModelZoomModal.astro';
import commissionsData from '../data/commissions.json';
import '../styles/global.css';
import '../styles/commissions.css';

const { 
  atelier, 
  recommendedPackages, 
  tierPricing, 
  accessories, 
  illustrations, 
  showcases, 
  terms 
} = commissionsData;

const commissionsSchema = {
  "@type": "ProfessionalService",
  "@id": "https://winest.studio/commissions#service",
  "name": "WINEST x KENELIX STUDIO Commissions",
  "url": "https://winest.studio/commissions",
  "description": "บริการสร้างสรรค์งานโปรดักชัน: โมเดล Live2D และภาพวาดฉากสตรีมมิ่ง สำหรับครีเอเตอร์และ VTuber คุณภาพระดับมืออาชีพ",
  "provider": { "@id": "https://winest.studio/#organization" },
  "areaServed": "Worldwide",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Live2D & Creative Art Production",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Live2D Model Design & Rigging"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Streaming Background & Room Illustration"
        }
      }
    ]
  }
};
---

<Layout 
  title="WINEST x KENELIX STUDIO - Creative Studio & Commissions"
  description="บริการสร้างสรรค์งานโปรดักชัน: โมเดล Live2D และภาพวาดฉากสตรีมมิ่ง สำหรับครีเอเตอร์และ VTuber คุณภาพระดับมืออาชีพ"
  schema={commissionsSchema}
>
  <Navbar />

  <main class="commissions-main" id="commissions-main">
    <div class="container">

      <!-- ============================================================
           HEADER: Editorial Masthead
           ============================================================ -->
      <header class="commissions-masthead">
        <h1 class="masthead-title">{atelier.title}</h1>
        <p class="masthead-lead">{atelier.lead}</p>

        <!-- Quick Navigation Anchors (Same as /about) -->
        <nav class="about-nav-anchors" aria-label="Quick section navigation">
          <a href="#models-section" class="about-anchor-pill dock-link">
            <span class="dock-index">01</span>
            <span>Live2D Models</span>
          </a>
          <a href="#illustration-section" class="about-anchor-pill dock-link">
            <span class="dock-index">02</span>
            <span>Backgrounds</span>
          </a>
          <a href="#showcase-section" class="about-anchor-pill dock-link">
            <span class="dock-index">03</span>
            <span>Motion Showcase</span>
          </a>
          <a href="#studio-terms" class="about-anchor-pill dock-link">
            <span class="dock-index">04</span>
            <span>Terms & Guidelines</span>
          </a>
        </nav>
      </header>

      <!-- ============================================================
           PART 1: Live2D Models (Recommended Packages)
           ============================================================ -->
      <section class="recommended-section" id="models-section">
        <h2 class="section-heading has-desc">Live2D Model Packages</h2>
        <p class="section-desc">แพ็กเกจคอมโบงานวาดแยกชิ้นส่วนและริกเกลี่ยการเคลื่อนไหวครบวงจร พร้อมไฟล์ติดตั้งใช้งานได้ทันที</p>

        <div class="recommended-cards-grid">
          {recommendedPackages.map((pkg) => (
            <article class="package-card">
              <div class="pkg-header">
                <div class="pkg-identity">
                  <h3 class="pkg-title">{pkg.name}</h3>
                </div>

                <div class="pkg-price-row">
                  <span class="price-lead">เริ่มต้น</span>
                  <span class="price-num">฿{pkg.startingPrice.toLocaleString()}</span>
                  {pkg.originalPrice && (
                    <s class="price-original">฿{pkg.originalPrice.toLocaleString()}</s>
                  )}
                  {pkg.discountPercent && (
                    <span class="price-discount-badge">{pkg.discountPercent}</span>
                  )}
                </div>
              </div>

              <!-- 3 Clean Bullets -->
              <ul class="pkg-bullets">
                {pkg.bullets.map((bullet, bIdx) => (
                  <li class="pkg-bullet-item">
                    <Icon name={bIdx === 2 ? 'avatar-star' : 'check'} width="13" height="13" class="pkg-bullet-svg" />
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>

              <!-- Action Button -->
              <a 
                href={atelier.discordUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="pkg-cta"
              >
                <span>สั่งทำ {pkg.name}</span>
                <span aria-hidden="true">↗</span>
              </a>
            </article>
          ))}
        </div>
      </section>

      <!-- Complete Price Comparison Matrix (Tiers & Accessories) -->
      <section class="pricing-matrix-section" id="pricing-matrix">
        <h2 class="section-heading has-desc">Full Pricing Catalog</h2>
        <p class="section-desc">รายละเอียดเรทราคาวาดและริกโมเดลตามแต่ละแพ็กเกจ และชิ้นส่วนเสริม</p>

        <!-- Tier 1-3 Table -->
        <h3 class="table-subheading">เรทราคาวาดและริกโมเดลแยกตามระดับ (Tier 1 – 3)</h3>
        <div class="table-scroll-wrapper">
          <table class="comparison-table">
            <thead>
              <tr>
                <th>แพ็กเกจโมเดล</th>
                <th>ระดับ (Tier)</th>
                <th>เฉพาะวาด (Draw)</th>
                <th>เฉพาะริก (Rig)</th>
                <th>โปร วาด & ริก (Combo Set)</th>
              </tr>
            </thead>
            <tbody>
              {tierPricing.flatMap((group) =>
                group.tiers.map((t, tIdx) => (
                  <tr class={tIdx === 0 ? 'group-start' : ''}>
                    <td class="pkg-cell">{tIdx === 0 ? group.package : ''}</td>
                    <td>{t.tier}</td>
                    <td class="num-cell">฿{t.draw.toLocaleString()}</td>
                    <td class="num-cell">฿{t.rig.toLocaleString()}</td>
                    <td class="combo-cell">฿{t.combo.toLocaleString()}</td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>

        <!-- Accessory Table -->
        <h3 class="table-subheading">เรทราคาส่วนเสริม Accessory (ACC) แยกตามระดับความซับซ้อน</h3>
        <div class="table-scroll-wrapper">
          <table class="comparison-table">
            <thead>
              <tr>
                <th>รายการส่วนเสริม</th>
                <th>Tier 1 (ลด 20%)</th>
                <th>Tier 2 (ลด 25%)</th>
                <th>Tier 3 (ลด 30%)</th>
              </tr>
            </thead>
            <tbody>
              {accessories.map((acc) => (
                <tr>
                  <td><strong>{acc.category}</strong></td>
                  {acc.customNote ? (
                    <td colspan="3" style="color: var(--text-secondary);">{acc.customNote}</td>
                  ) : (
                    <>
                      <td class="num-cell">฿{acc.half?.combo.toLocaleString()} <span style="font-size: 0.75rem; color: var(--text-secondary);">(วาด {acc.half?.draw} / ริก {acc.half?.rig})</span></td>
                      <td class="num-cell">฿{acc.simple?.combo.toLocaleString()} <span style="font-size: 0.75rem; color: var(--text-secondary);">(วาด {acc.simple?.draw} / ริก {acc.simple?.rig})</span></td>
                      <td class="combo-cell">฿{acc.full?.combo.toLocaleString()} <span style="font-size: 0.75rem; color: var(--text-secondary);">(วาด {acc.full?.draw} / ริก {acc.full?.rig})</span></td>
                    </>
                  )}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="table-note" style="font-size: 0.8125rem; color: var(--text-secondary); margin-top: -20px; margin-bottom: 32px; line-height: 1.5;">
          * งานส่วนเสริม ACC คิดราคาตามรายละเอียดและความซับซ้อนของชิ้นงาน · แถมฟรีหน้าตา 3 หน้าในทุกแพ็กเกจโมเดลหลัก
        </p>
      </section>

      <!-- ============================================================
           PART 2: Background Illustration
           ============================================================ -->
      <section class="recommended-section" id="illustration-section">
        <h2 class="section-heading has-desc">{illustrations.title}</h2>
        <p class="section-desc">{illustrations.lead}</p>

        <div class="recommended-cards-grid">
          {illustrations.items.map((item) => (
            <article class="package-card">
              <div class="pkg-header">
                <div class="pkg-identity">
                  <h3 class="pkg-title">{item.title}</h3>
                </div>

                <div class="pkg-price-row">
                  <span class="price-num" style="font-size: 1.25rem;">{item.rate}</span>
                  <span class="price-lead" style="font-size: 0.75rem;">({item.rateSub})</span>
                </div>
              </div>

              <!-- 3 Clean Bullets -->
              <ul class="pkg-bullets">
                {item.bullets.map((bullet) => (
                  <li class="pkg-bullet-item">
                    <Icon name="check" width="13" height="13" class="pkg-bullet-svg" />
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>

              <!-- Action Button -->
              <a 
                href={atelier.discordUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="pkg-cta"
              >
                <span>ส่งบรีฟฉาก {item.title} ↗</span>
              </a>
            </article>
          ))}
        </div>
      </section>

      <!-- ============================================================
           PART 3: Showcase & Motion Preview (Real Portfolio & Videos)
           ============================================================ -->
      <section class="portfolio-showcase-section" id="showcase-section">
        <h2 class="section-heading has-desc">Showcase & Motion Preview</h2>
        <p class="section-desc">ผลงานโมเดลที่ผลิตโดย Kenelix Studio พร้อมคลิปสาธิตการริกการเคลื่อนไหวจริง</p>

        <!-- Featured Rigging Video Showcase (High-Performance YouTube Lite Facade) -->
        <div class="motion-demo-duet">
          <div class="motion-demo-card">
            <div
              class="motion-video-frame youtube-facade"
              data-video-id="eiN2K9_ywZ8"
              data-title="Butterfly Pea Soda - Rigging Showcase"
              role="button"
              tabindex="0"
              aria-label="กดเพื่อเล่นคลิป Butterfly Pea Soda - Rigging Showcase"
            >
              <img
                src="https://i.ytimg.com/vi/eiN2K9_ywZ8/hqdefault.jpg"
                alt="Butterfly Pea Soda - Rigging Showcase Preview"
                class="facade-poster"
                loading="lazy"
                decoding="async"
                width="480"
                height="270"
              />
              <button
                type="button"
                class="facade-play-btn"
                tabindex="-1"
                aria-hidden="true"
              >
                <svg viewBox="0 0 24 24" width="28" height="28">
                  <path d="M8 5v14l11-7z" fill="currentColor"></path>
                </svg>
              </button>
            </div>
            <div class="motion-card-caption">
              <div>
                <span class="motion-badge">Rigging Showcase 01</span>
                <h3 class="motion-title">Butterfly Pea Soda (Tier 1)</h3>
              </div>
              <a href="https://www.youtube.com/watch?v=eiN2K9_ywZ8" target="_blank" rel="noopener noreferrer" class="motion-yt-link">
                <span>เปิดดูบน YouTube</span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>

          <div class="motion-demo-card">
            <div
              class="motion-video-frame youtube-facade"
              data-video-id="fr13SGsi8ac"
              data-title="Starberry Cake - Rigging Showcase"
              role="button"
              tabindex="0"
              aria-label="กดเพื่อเล่นคลิป Starberry Cake - Rigging Showcase"
            >
              <img
                src="https://i.ytimg.com/vi/fr13SGsi8ac/hqdefault.jpg"
                alt="Starberry Cake - Rigging Showcase Preview"
                class="facade-poster"
                loading="lazy"
                decoding="async"
                width="480"
                height="270"
              />
              <button
                type="button"
                class="facade-play-btn"
                tabindex="-1"
                aria-hidden="true"
              >
                <svg viewBox="0 0 24 24" width="28" height="28">
                  <path d="M8 5v14l11-7z" fill="currentColor"></path>
                </svg>
              </button>
            </div>
            <div class="motion-card-caption">
              <div>
                <span class="motion-badge">Rigging Showcase 02</span>
                <h3 class="motion-title">Starberry Cake (Tier 2)</h3>
              </div>
              <a href="https://www.youtube.com/watch?v=fr13SGsi8ac" target="_blank" rel="noopener noreferrer" class="motion-yt-link">
                <span>เปิดดูบน YouTube</span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </div>

        <!-- 6 Models Portfolio Grid -->
        <div class="models-portfolio-grid">
          {showcases && showcases.map((model) => (
            <article class="model-portfolio-card">
              <div 
                class="model-img-wrapper" 
                role="button" 
                tabindex="0" 
                aria-label={`คลิกเพื่อเปิดดูภาพขยายและซูมรายละเอียดของ ${model.name}`}
                title="คลิกเพื่อดูภาพขยายและซูมรายละเอียด"
              >
                <img 
                  src={model.image} 
                  alt={`${model.name} Live2D Model Showcase (${model.tier}) - WINEST Kenelix Studio`} 
                  loading="lazy" 
                  decoding="async" 
                  width="480"
                  height="600"
                />
              </div>
              <div class="model-card-body">
                <div class="model-meta-top">
                  <span class="model-num">{model.number}</span>
                  <span class="model-tier-pill">{model.tier}</span>
                </div>
                <h3 class="model-name">{model.name}</h3>
                <div class="model-credits">
                  <span>Art: {model.artist}</span>
                  <span class="credit-sep">|</span>
                  <span>Rig: {model.rigger}</span>
                </div>
                <p class="model-features">{model.features}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- ============================================================
           PART 4: Terms & Guidelines (Editorial 3-Col Split)
           ============================================================ -->
      <section class="terms-split-section" id="studio-terms">
        <h2 class="section-heading has-desc">Terms & Guidelines</h2>
        <p class="section-desc">รายละเอียดเงื่อนไขระยะเวลา การผ่อนชำระ และนโยบายการแก้งาน</p>

        <div class="terms-3col-layout">
          {terms.map((col) => (
            <div class="terms-col">
              <h3 class="terms-col-title">{col.title}</h3>
              <ul class="terms-list">
                {col.points.map((pt) => (
                  <li class="terms-item">
                    <Icon name="check" width="12" height="12" class="terms-svg" />
                    <span>{pt}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- ============================================================
           PART 5: Minimal Closing Action
           ============================================================ -->
      <section class="closing-action-section">
        <h2 class="closing-title">Ready to Start Your Production?</h2>
        <p class="closing-desc">
          ปรึกษาประเมินคิวงาน หรือส่งไฟล์บรีฟสำหรับงานโมเดลและงานวาดฉากกับทีมงาน Kenelix Studio โดยตรง
        </p>
        <a href={atelier.discordUrl} target="_blank" rel="noopener noreferrer" class="closing-btn">
          <span>ติดต่อผ่าน Discord (Kenelix Studio)</span>
          <span aria-hidden="true">↗</span>
        </a>
      </section>

    </div>
  </main>

  <!-- Interactive Lightbox & Image Zoom Modal for Portfolio Models -->
  <ModelZoomModal />

  <Footer />

  <script>
    // Smooth scroll navigation with precise offset
    document.querySelectorAll('.dock-link[href^="#"]').forEach((link) => {
      link.addEventListener('click', (e) => {
        const targetId = link.getAttribute('href');
        if (targetId && targetId.startsWith('#')) {
          const targetEl = document.querySelector(targetId);
          if (targetEl) {
            e.preventDefault();
            const navbar = document.querySelector('.navbar');
            const navOffset = navbar ? (navbar as HTMLElement).offsetHeight : 72;
            const targetY = targetEl.getBoundingClientRect().top + window.pageYOffset - navOffset - 24;
            window.scrollTo({
              top: targetY,
              behavior: 'smooth'
            });
            history.pushState(null, '', targetId);
          }
        }
      });
    });

    // YouTube Lite Facade Click-to-Play Engine
    function initYouTubeFacades() {
      document.querySelectorAll('.youtube-facade').forEach((facade) => {
        const el = facade as HTMLElement;
        if (el.dataset.bound) return;
        el.dataset.bound = 'true';

        function activateVideo() {
          const videoId = el.getAttribute('data-video-id');
          const title = el.getAttribute('data-title') || 'Rigging Showcase';
          if (!videoId) return;
          const iframe = document.createElement('iframe');
          iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0`;
          iframe.title = title;
          iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
          iframe.allowFullscreen = true;
          el.innerHTML = '';
          el.appendChild(iframe);
        }

        el.addEventListener('click', activateVideo);
        el.addEventListener('keydown', (e: KeyboardEvent) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            activateVideo();
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initYouTubeFacades);
    } else {
      initYouTubeFacades();
    }
    document.addEventListener('astro:page-load', initYouTubeFacades);
  </script>
</Layout>
