---
// src/pages/commissions.astro - World-Class Editorial Commissions Showcase
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/common/Icon.astro';
import commissionsData from '../data/commissions.json';
import '../styles/global.css';
import '../styles/commissions.css';

const { atelier, models, terms, showcases } = commissionsData;
---

<Layout 
  title="WINEST x KENELIX STUDIO - Live2D Model Commissions"
  description="บริการออกแบบ วาดชิ้นส่วนแยกเลเยอร์ และริกโมเดล Live2D ครบวงจรสำหรับ VTuber และครีเอเตอร์ เปรียบเทียบสเปก 3 แพ็กเกจ เรทราคา และเงื่อนไขการผ่อนชำระ"
>
  <Navbar />

  <main class="commissions-main" id="commissions-main">
    <div class="container">

      <!-- ============================================================
           1. Editorial Masthead
           ============================================================ -->
      <header class="commissions-masthead">
        <div class="masthead-meta">{atelier.collaboration}</div>
        <h1 class="masthead-title">{atelier.title}</h1>
        <p class="masthead-lead">{atelier.lead}</p>

        <div class="masthead-action-row">
          <a href="#models-matrix" class="editorial-text-link">
            <span>เลือกแพ็กเกจโมเดล</span>
            <span aria-hidden="true">↓</span>
          </a>
          <a href="#studio-terms" class="editorial-text-link">
            <span>เงื่อนไขและการผ่อนชำระ</span>
            <span aria-hidden="true">↓</span>
          </a>
          <a href={atelier.discordUrl} target="_blank" rel="noopener noreferrer" class="editorial-text-link primary">
            <span>ติดต่อสั่งทำผ่าน Discord</span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </header>

      <!-- ============================================================
           2. Self-Contained Model Cards Grid
           Organized with | and clean SVGs for effortless scanning
           ============================================================ -->
      <section class="models-matrix-section" id="models-matrix">
        <span class="section-label">Model Architecture</span>
        <h2 class="section-heading">แพ็กเกจโมเดล Live2D</h2>

        <div class="models-card-grid">
          {models.map((model) => (
            <article class="package-editorial-card">
              <!-- Card Header -->
              <div class="pkg-header">
                <div class="pkg-identity">
                  <h3 class="pkg-title">{model.name}</h3>
                  <span class="pkg-tag">{model.subtitle}</span>
                </div>
                <p class="pkg-summary">{model.summary}</p>

                <!-- Starting Price Block with Pipe -->
                <div class="pkg-price-banner">
                  <div class="pkg-price-main">
                    <span class="price-val">฿{model.startingPrice.toLocaleString()}</span>
                    <span class="price-unit">THB</span>
                  </div>
                  <div class="pkg-price-sub">
                    <span>วาด ฿{model.tiers[0].draw.toLocaleString()}</span>
                    <span class="pipe" aria-hidden="true">|</span>
                    <span>ริก ฿{model.tiers[0].rig.toLocaleString()}</span>
                    <span class="pipe" aria-hidden="true">|</span>
                    <span class="pkg-discount">{model.discount}</span>
                  </div>
                </div>
              </div>

              <!-- Specs Bullets with SVGs & Pipe -->
              <div class="pkg-specs-block">
                <div class="pkg-spec-row">
                  <Icon name="check" width="14" height="14" class="spec-svg" />
                  <span class="spec-text">
                    <strong>สัดส่วน:</strong> {model.specs.scope}
                  </span>
                </div>
                <div class="pkg-spec-row">
                  <Icon name="check" width="14" height="14" class="spec-svg" />
                  <span class="spec-text">
                    <strong>โครงสร้าง:</strong> {model.specs.interiorBody}
                    <span class="pipe" aria-hidden="true">|</span>
                    {model.specs.outfitSystem}
                  </span>
                </div>
                <div class="pkg-spec-row highlight">
                  <Icon name="avatar-star" width="14" height="14" class="spec-svg star" />
                  <span class="spec-text">
                    <strong>ของแถม:</strong> {model.specs.included}
                  </span>
                </div>
              </div>

              <!-- Compact Tier Rates Table inside Card -->
              <div class="pkg-tiers-section">
                <div class="pkg-section-label">
                  <span>เรทราคา Tier 1–3</span>
                  <span class="pipe" aria-hidden="true">|</span>
                  <span>วาด · ริก · คอมโบ</span>
                </div>

                <div class="pkg-tier-rows">
                  {model.tiers.map((t) => (
                    <div class="pkg-tier-row">
                      <span class="tier-name">{t.name}</span>
                      <div class="tier-rates">
                        <span>วาด ฿{t.draw.toLocaleString()}</span>
                        <span class="pipe" aria-hidden="true">|</span>
                        <span>ริก ฿{t.rig.toLocaleString()}</span>
                        <span class="pipe" aria-hidden="true">|</span>
                        <span class="rate-item combo">Combo ฿{t.combo.toLocaleString()}</span>
                      </div>
                    </div>
                  ))}
                </div>
              </div>

              <!-- Accessory Section inside Card -->
              <div class="pkg-acc-section">
                <div class="pkg-section-label">
                  <span>ส่วนเสริม Accessory ({model.accessory.label})</span>
                  <span class="pipe" aria-hidden="true">|</span>
                  <span class="acc-discount">{model.accessory.discount}</span>
                </div>
                <div class="pkg-acc-items">
                  {model.accessory.items.map((acc, i) => (
                    <span>
                      {acc.type.split('/')[0].trim()} <strong>฿{acc.combo.toLocaleString()}</strong>
                      {i < model.accessory.items.length - 1 ? <span class="pipe" aria-hidden="true">|</span> : ''}
                    </span>
                  ))}
                </div>
              </div>

              <!-- Action Link -->
              <a 
                href={atelier.discordUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="pkg-cta-btn"
              >
                <span>ปรึกษาบรีฟ {model.name}</span>
                <span aria-hidden="true">↗</span>
              </a>
            </article>
          ))}
        </div>
      </section>

      <!-- ============================================================
           3. Terms, Timeline & Installment (Editorial 3-Col Split)
           ============================================================ -->
      <section class="terms-split-section" id="studio-terms">
        <span class="section-label">Commercial Guidelines</span>
        <h2 class="section-heading">ระยะเวลา การผ่อนชำระ และนโยบายสตูดิโอ</h2>

        <div class="terms-3col-layout">
          {terms.map((col) => (
            <div class="terms-col">
              <div class="terms-col-head">
                <h3 class="terms-col-title">{col.title}</h3>
                <div class="terms-col-sub">{col.subtitle}</div>
              </div>

              <div class="terms-kv-list">
                {col.items.map((item) => (
                  <div class="terms-kv-item">
                    <div class="terms-item-line">
                      <Icon name="check" width="13" height="13" class="terms-svg" />
                      <span class="terms-k">{item.label}</span>
                    </div>
                    <span class="terms-v">{item.value}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- ============================================================
           4. Official Talents Showcase (Pristine Art Duet)
           ============================================================ -->
      <section class="showcase-duet-section">
        <span class="section-label">Selected Works</span>
        <h2 class="section-heading">โมเดลทาเลนต์ประจำค่าย WINEST</h2>

        <div class="showcase-duet-grid">
          {showcases.map((talent) => (
            <article class="showcase-talent-frame">
              <div class="showcase-talent-art">
                <img src={talent.image} alt={talent.name} loading="lazy" decoding="async" />
              </div>
              <div class="talent-caption-bar">
                <div>
                  <h3>{talent.name}</h3>
                  <div style="font-size: 0.8125rem; color: var(--text-secondary);">{talent.artist}</div>
                </div>
                <span class="talent-spec-meta">{talent.title}</span>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- ============================================================
           5. Minimal Closing Action
           ============================================================ -->
      <section class="closing-action-section">
        <h2 class="closing-title">พร้อมเริ่มต้นโปรดักชันโมเดลของคุณ?</h2>
        <p class="closing-desc">
          พูดคุยสอบถามรายละเอียด ประเมินคิวงาน หรือส่งไฟล์บรีฟตัวละครกับทีมงาน Kenelix Studio โดยตรง
        </p>
        <a href={atelier.discordUrl} target="_blank" rel="noopener noreferrer" class="closing-btn">
          <span>ติดต่อผ่าน Discord (Kenelix Studio)</span>
          <span aria-hidden="true">↗</span>
        </a>
      </section>

    </div>
  </main>

  <Footer />
</Layout>
